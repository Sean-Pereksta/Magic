rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed() {
      return request.auth != null;
    }

    function turncraftType(data) { return data.get('gameType','') == 'turncraft'; }
    // Personal progress and competitive receipts use the existing Firebase Auth
    // identity. Only Firebase Admin may write these authority collections.
    match /turncraftProfiles/{uid} {
      allow get: if isAuthed() && request.auth.uid == uid;
      allow list, write: if false;
      match /{subcollection}/{recordId} {
        allow read: if isAuthed() && request.auth.uid == uid && subcollection == 'history';
        allow write: if false;
      }
    }
    match /turncraftRankings/{uid} { allow read: if isAuthed(); allow write: if false; }
    match /turncraftMatches/{id} { allow read, write: if false; match /{sub=**} { allow read, write: if false; } }
    match /turncraftInvites/{id} { allow read, write: if false; }
    match /turncraftLobbySecrets/{id} { allow read, write: if false; }
    match /turncraftLobbyRequests/{id} { allow read, write: if false; }
    match /turncraftRatingPairs/{id} { allow read, write: if false; }
    match /turncraftRankedQueue/{uid} { allow read, write: if false; }
    function turncraftProfileCreate() { return !request.resource.data.get('gameStats',{}).keys().hasAny(['turncraft']); }
    function turncraftProfileUpdate() {
      return request.resource.data.get('gameStats',{}).get('turncraft',null) == resource.data.get('gameStats',{}).get('turncraft',null);
    }

    function validCountryQuestScore() {
      return isAuthed()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 20
        && request.resource.data.category in [
          'map_easy_lives', 'map_easy_timed',
          'map_hard_lives', 'map_hard_timed',
          'flag_easy_lives', 'flag_easy_timed',
          'flag_hard_lives', 'flag_hard_timed',
          'flagmap_easy_lives', 'flagmap_easy_timed',
          'flagmap_hard_lives', 'flagmap_hard_timed',
          'distance_easy_score', 'distance_hard_score',
          'stats_easy_score', 'stats_hard_score',
          'map_lives', 'map_timed',
          'flag_lives', 'flag_timed',
          'flagmap_lives', 'flagmap_timed',
          'regions_score', 'stats_score'
        ]
        && request.resource.data.gameMode in ['map', 'distance', 'flag', 'flagmap', 'regions', 'stats']
        && request.resource.data.challengeMode in ['lives', 'timed', 'score']
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.maxScore is int
        && request.resource.data.maxScore >= 1
        && request.resource.data.maxScore <= 2000000000
        && request.resource.data.score <= request.resource.data.maxScore
        && request.resource.data.correct is int
        && request.resource.data.correct >= 0
        && request.resource.data.correct <= request.resource.data.total
        && request.resource.data.total is int
        && request.resource.data.total >= 25
        && request.resource.data.total <= 300
        && request.resource.data.mistakes is int
        && request.resource.data.mistakes >= 0
        && request.resource.data.elapsedMs is int
        && request.resource.data.elapsedMs >= 0
        && request.resource.data.penaltyMs is int
        && request.resource.data.penaltyMs >= 0
        && request.resource.data.completed is bool
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'category', 'gameMode', 'challengeMode',
          'score', 'maxScore', 'correct', 'total', 'mistakes', 'elapsedMs',
          'penaltyMs', 'completed', 'updatedAt'
        ]);
    }

    // New authority collections are never covered by a legacy recursive grant.
    // Binding records are provisioned only by Firebase Admin after owner recovery.
    match /factionForgeAccounts/{uid} {
      allow get: if isAuthed() && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /factionForgeNames/{username} { allow read, write: if false; }
    match /factionForgeLobbySessions/{lobbyId} { allow read, write: if false; }
    match /factionForgeProfiles/{uid} {
      allow get: if isAuthed() && request.auth.uid == uid;
      allow list, write: if false;
      match /{subcollection}/{recordId} {
        allow read: if isAuthed() && request.auth.uid == uid && subcollection in ['history','upgrades'];
        allow write: if false;
      }
    }
    // Read matches through the authenticated API. Private seeds, frozen profiles,
    // receipts, and server replay state must never be client-mutable or public.
    match /factionForgeMatches/{matchId} {
      allow read, write: if false;
      match /{sub=**} { allow read, write: if false; }
    }
    function forgeProtectedProfileFields() {
      return ['crowncouncilElo','crowncouncilLastDelta','crowncouncilLastMatchAt',
        'factionForge','factionForgeUid','forgeDust','forgeTier','troopCards',
        'campaignProgress','ownerUid','authUid','turncraft','turncraftMMR','turncraftStats'];
    }
    function forgeBoundOwner(username) {
      return !exists(/databases/$(database)/documents/factionForgeNames/$(username))
        || get(/databases/$(database)/documents/factionForgeNames/$(username)).data.uid == request.auth.uid;
    }
    match /users/{userId} {
      allow read: if isAuthed();
      // Keep existing unrelated profile fields compatible; migrated usernames
      // become owner-only. Ratings and progression are Firebase Admin writes.
      allow create: if isAuthed() && forgeBoundOwner(userId)
        && turncraftProfileCreate()
        && !request.resource.data.keys().hasAny(forgeProtectedProfileFields());
      allow update: if isAuthed() && forgeBoundOwner(userId)
        && turncraftProfileUpdate()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(forgeProtectedProfileFields());
      allow delete: if false;

      // Read the old per-device location only for that Firebase Auth identity.
      match /tiny_troops_profiles/{saveName} {
        allow get: if isAuthed() && request.auth.uid == userId;
      }
    }

    function validTinyTroopsSave(saveName) {
      let data = request.resource.data;
      return isAuthed() && saveName.matches('^[a-z0-9_-]{1,28}$')
        && data.cleanUsername == saveName
        && data.username is string && data.username.size() >= 1 && data.username.size() <= 100
        && data.password is string && data.password.size() >= 1 && data.password.size() <= 48
        && data.saveVersion == 'tiny_troops_v1'
        && data.updatedAtMs is int && data.updatedAtMs >= 0
        && data.sequence is int && data.sequence >= 0
        && data.reason is string && data.reason.size() <= 100
        && data.state is map && data.state.saveVersion == 'tiny_troops_v1'
        && data.state.round is int && data.state.round >= 1
        && data.state.squad is list && data.state.squad.size() in [16,20]
        && data.updatedAt == request.time
        && data.keys().hasOnly(['username','cleanUsername','password','saveVersion','updatedAtMs','sequence','reason','createOnly','state','updatedAt']);
    }

    match /tiny_troops_profiles/{saveName} {
      // Save-name/code lookup is supported; browsing every player's file is not.
      allow get: if isAuthed();
      allow create: if validTinyTroopsSave(saveName);
      allow update: if validTinyTroopsSave(saveName)
        && request.resource.data.password == resource.data.password
        && request.resource.data.updatedAtMs >= resource.data.updatedAtMs;

      match /runs/{runId} {
        allow read: if isAuthed();
        allow create: if isAuthed() && request.resource.data.runId == runId
          && request.resource.data.username is string
          && request.resource.data.round is int && request.resource.data.round >= 1
          && request.resource.data.kills is number && request.resource.data.kills >= 0
          && request.resource.data.points is number && request.resource.data.points >= 0
          && request.resource.data.coins is number && request.resource.data.coins >= 0
          && request.resource.data.dateTime is string
          && request.resource.data.keys().hasOnly(['username','round','kills','points','coins','dateTime','runId']);
      }
    }

    match /tiny_troops_meta/{documentId} {
      allow get: if isAuthed() && documentId == 'global_leaderboard';
      allow create, update: if isAuthed() && documentId == 'global_leaderboard'
        && request.resource.data.top10 is list && request.resource.data.top10.size() <= 10
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly(['top10','updatedAt']);
    }

    match /lobbies/{gameId} {
      allow read: if isAuthed();
      allow create: if isAuthed() && !turncraftType(request.resource.data) && ((forgeLobbyType(request.resource.data)) ? forgeLobbyCreate() : (request.resource.data.get('gameType','') != 'ironthrone' || (
        request.resource.data.hostUid == request.auth.uid && request.resource.data.members.keys().hasOnly([request.auth.uid])
        && request.resource.data.members[request.auth.uid] == request.resource.data.host && request.resource.data.status == 'waiting')));
      allow update: if isAuthed() && ((turncraftType(resource.data) || turncraftType(request.resource.data)) ? turncraftLobbyUpdate() : ((forgeLobbyType(resource.data) || forgeLobbyType(request.resource.data)) ? forgeLobbyUpdate() : (resource.data.get('gameType','') != 'ironthrone' && request.resource.data.get('gameType','') != 'ironthrone' || (
        resource.data.get('gameType','') == 'ironthrone' && request.resource.data.get('gameType','') == 'ironthrone' && (
          (resource.data.status == 'waiting' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members','players','updatedAt'])
            && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid]) && request.resource.data.members.size() <= 6)
          || (resource.data.hostUid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']))
          || (ironController() && ironAfter().hostUid == request.auth.uid && request.resource.data.hostUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hostUid','host','updatedAt']))
        )))));
      allow delete: if isAuthed() && (!turncraftType(resource.data) || resource.data.get('turncraftVersion',0) != 1) && ((forgeLobbyType(resource.data)) ? forgeLobbyDelete() : (resource.data.get('gameType','') != 'ironthrone' || resource.data.hostUid == request.auth.uid && resource.data.status == 'waiting'));
      function turncraftMember() { return isAuthed() && turncraftType(ironLobby()) && request.auth.uid in ironLobby().get('members',{}); }
      function turncraftController() {
        let lobby=ironLobby();let lease=lobby.get('chessStarfrontController',{});
        return turncraftMember() && lobby.status == 'started' && lobby.get('ranked',false) == false
          && lease.get('ownerUid','') == request.auth.uid && lease.get('expiresAtMs',0) > request.time.toMillis();
      }
      function turncraftLobbyUpdate() {
        let a=resource.data;let b=request.resource.data;let fields=b.diff(a).affectedKeys();
        let old=a.get('chessStarfrontController',{});let lease=b.get('chessStarfrontController',{});
        return a.get('turncraftVersion',0) == 0
          ? b.gameType == a.gameType && b.get('turncraftVersion',0) == 0 && !fields.hasAny(['ranked','hostUid','members','turncraftSeats','turncraftPlayers'])
          : a.get('turncraftVersion',0) == 1 && turncraftType(a) && turncraftType(b)
          && a.status == 'started' && a.get('ranked',false) == false && request.auth.uid in a.members
          && fields.hasOnly(['chessStarfrontController','updatedAt'])
          && lease.keys().hasOnly(['ownerUid','ownerName','expiresAtMs','epoch'])
          && lease.ownerUid == request.auth.uid && lease.ownerName == a.members[request.auth.uid]
          && lease.expiresAtMs > request.time.toMillis() && lease.expiresAtMs <= request.time.toMillis()+22000
          && (old.get('ownerUid','') == request.auth.uid || old.get('expiresAtMs',0) <= request.time.toMillis())
          && lease.epoch == (old.get('ownerUid','') == request.auth.uid ? old.get('epoch',1) : old.get('epoch',0)+1);
      }
      match /chess_starfront/{stateId} {
        allow read: if turncraftMember();
        allow create, update: if stateId == 'state' && turncraftController()
          && request.resource.data.controllerUid == request.auth.uid
          && request.resource.data.controllerEpoch == ironLobby().chessStarfrontController.epoch;
        allow delete: if false;
      }
      match /chess_starfront_presence/{presenceId} {
        allow read: if turncraftMember();
        allow create, update: if turncraftMember() && ironLobby().get('ranked',false) == false && request.resource.data.uid == request.auth.uid
          && request.resource.data.username == ironLobby().members[request.auth.uid]
          && request.resource.data.slot is int && request.resource.data.slot >= 0
          && ironLobby().turncraftSeats[request.resource.data.slot] == request.auth.uid;
        allow delete: if turncraftMember() && resource.data.uid == request.auth.uid;
      }
      match /chess_starfront_commands/{commandId} {
        allow read: if turncraftMember();
        allow create: if turncraftMember() && ironLobby().get('ranked',false) == false && ironLobby().status == 'started'
          && request.resource.data.by == ironLobby().members[request.auth.uid]
          && request.resource.data.slot is int && request.resource.data.slot >= 0
          && ironLobby().turncraftSeats[request.resource.data.slot] == request.auth.uid;
        allow update: if false;
        allow delete: if turncraftController();
      }
      function forgeLobbyType(data) { return data.get('gameType','') in ['crowncouncil','factionforge']; }
      function forgeMemberList(data) {
        return data.members is map && data.members.size() >= 1 && data.members.size() <= 2
          && data.players is list && data.players.size() == data.members.size()
          && data.players.toSet() == data.members.values().toSet()
          && data.hostUid in data.members && data.members[data.hostUid] == data.host;
      }
      function forgeLobbyCreate() {
        let data=request.resource.data;
        return data.hostUid == request.auth.uid && data.status == 'waiting'
          && data.visibility in ['public','private'] && data.get('forgeRanked',true) is bool && data.host is string
          && data.host.size() >= 1 && data.host.size() <= 80
          && forgeMemberList(data) && data.members.keys().hasOnly([request.auth.uid]);
      }
      function forgeLobbyUpdate() {
        let a=resource.data; let b=request.resource.data; let fields=b.diff(a).affectedKeys();
        // Pre-update legacy rooms retain practice compatibility but cannot be
        // promoted to trusted UID rooms by an arbitrary authenticated writer.
        return a.get('hostUid','') == ''
          ? b.gameType == a.gameType && !fields.hasAny(['hostUid','members','visibility'])
          : a.hostUid == b.hostUid && a.host == b.host && a.gameType == b.gameType
            && a.visibility == b.visibility && forgeMemberList(b)
            && (a.get('forgeRanked',true) == b.get('forgeRanked',true) || a.hostUid == request.auth.uid && a.status == 'waiting') && (
              (fields.hasOnly(['members','players','updatedAt'])
                && b.members.diff(a.members).affectedKeys().hasOnly([request.auth.uid])
                && (request.auth.uid in a.members || a.status == 'waiting')
                && (!(request.auth.uid in b.members) || b.members[request.auth.uid] is string
                  && b.members[request.auth.uid].size() >= 1 && b.members[request.auth.uid].size() <= 80)
                && (!(request.auth.uid in a.members) || !(request.auth.uid in b.members)
                  || a.members[request.auth.uid] == b.members[request.auth.uid]))
              || (a.hostUid == request.auth.uid && fields.hasOnly(['members','players','updatedAt'])
                && b.members.diff(a.members).addedKeys().size() == 0
                && b.members.diff(a.members).changedKeys().size() == 0)
              || (a.hostUid == request.auth.uid && fields.hasOnly(['status','updatedAt'])
                && b.status in ['waiting','started','closed'])
              || (a.hostUid == request.auth.uid && a.status == 'waiting'
                && fields.hasOnly(['forgeRanked','updatedAt']) && b.forgeRanked is bool)
            );
      }
      function forgeLobbyDelete() {
        return resource.data.get('hostUid','') == '' || resource.data.hostUid == request.auth.uid;
      }
      // Iron Thrones uses UID seats and a lease-fenced simulation. These rules
      // intentionally exclude its paths from the legacy recursive lobby grant.
      function ironLobby() { return get(/databases/$(database)/documents/lobbies/$(gameId)).data; }
      function ironMeta() { return get(/databases/$(database)/documents/lobbies/$(gameId)/iron_throne/meta).data; }
      function ironAfter() { return getAfter(/databases/$(database)/documents/lobbies/$(gameId)/iron_throne/meta).data; }
      function ironMember() { return isAuthed() && ironLobby().gameType == 'ironthrone' && request.auth.uid in ironLobby().members; }
      function ironHouse(id) { return id in ['ashen','wintermere','thornwall','sunspire','vesper','redharbor']; }
      function ironControls(m) { return m.lease != null && m.lease.uid == request.auth.uid && m.lease.expiresAt > request.time; }
      function ironController() { return ironMember() && ironControls(ironMeta()); }
      function ironSeat(m, id) { return ironHouse(id) && m.seats[id].kind == 'human' && m.seats[id].uid == request.auth.uid; }
      function ironHasSeat(m) {
        return m.seats.ashen.uid == request.auth.uid || m.seats.wintermere.uid == request.auth.uid || m.seats.thornwall.uid == request.auth.uid
          || m.seats.sunspire.uid == request.auth.uid || m.seats.vesper.uid == request.auth.uid || m.seats.redharbor.uid == request.auth.uid;
      }
      function ironOwnSeatCount(m) {
        return (m.seats.ashen.uid == request.auth.uid ? 1 : 0) + (m.seats.wintermere.uid == request.auth.uid ? 1 : 0) + (m.seats.thornwall.uid == request.auth.uid ? 1 : 0) + (m.seats.sunspire.uid == request.auth.uid ? 1 : 0) + (m.seats.vesper.uid == request.auth.uid ? 1 : 0) + (m.seats.redharbor.uid == request.auth.uid ? 1 : 0);
      }
      function ironSeatChange(before, after, id) {
        let a=before.seats[id]; let b=after.seats[id];
        return a == b || (b.keys().hasOnly(['kind','uid','name','substitute']) && b.name is string && b.name.size() <= 40 && (
          (a.uid == request.auth.uid && b.kind == 'open' && b.uid == null)
          || (a.kind == 'open' && b.kind == 'human' && b.uid == request.auth.uid && b.substitute == false)
          || (before.hostUid == request.auth.uid && a.uid == null && b.uid == null && b.kind in ['ai','open'])
        ));
      }
      function ironLeaseValid(m) {
        return m.lease.uid == request.auth.uid && m.lease.token is string && m.lease.token.size() <= 64
          && m.lease.expiresAt > request.time && m.lease.expiresAt <= request.time + duration.value(45,'s');
      }
      function ironHostAbsent(m) {
        return !exists(/databases/$(database)/documents/lobbies/$(gameId)/iron_throne_presence/$(m.hostUid))
          || get(/databases/$(database)/documents/lobbies/$(gameId)/iron_throne_presence/$(m.hostUid)).data.at < request.time - duration.value(90,'s');
      }
      function ironSnapshotWrite() {
        let m=ironAfter();
        return ironMember() && ironControls(m) && request.resource.data.keys().hasOnly(['stateVersion','turn','epoch','payload'])
          && request.resource.data.stateVersion == m.stateVersion && request.resource.data.turn == m.turn && request.resource.data.epoch == m.epoch
          && request.resource.data.payload.format in ['gzip','json'] && request.resource.data.payload.data is string && request.resource.data.payload.data.size() < 750000;
      }
      function ironClaimUpdate(a,b) {
        return a.phase == 'setup' && b.phase == 'setup' && b.seats.keys().toSet() == a.seats.keys().toSet()
          && ironOwnSeatCount(b) <= 1
          && ironSeatChange(a,b,'ashen') && ironSeatChange(a,b,'wintermere') && ironSeatChange(a,b,'thornwall')
          && ironSeatChange(a,b,'sunspire') && ironSeatChange(a,b,'vesper') && ironSeatChange(a,b,'redharbor');
      }
      function ironLeaseUpdate(a,b) {
        return ironHasSeat(a) && ironLeaseValid(b)
          && (b.hostUid == a.hostUid || b.hostUid == request.auth.uid && ironHostAbsent(a))
          && ((a.lease == null || a.lease.expiresAt <= request.time) && b.epoch == a.epoch + 1
            || a.lease != null && a.lease.uid == request.auth.uid && a.lease.token == b.lease.token && b.epoch == a.epoch);
      }
      function ironStartUpdate(a,b) {
        return a.hostUid == request.auth.uid && b.phase == 'founding' && b.stateVersion == 1 && b.turn == 0
          && ironLeaseValid(b) && getAfter(/databases/$(database)/documents/lobbies/$(gameId)/iron_throne/state).data.stateVersion == 1;
      }
      function ironCommitUpdate(a,b,fields) {
        return ironControls(a) && b.lease == a.lease && b.epoch == a.epoch && b.hostUid == a.hostUid && b.options == a.options
          && ((b.stateVersion == a.stateVersion + 1 && b.turn >= a.turn && b.turn <= a.turn + 1
            && getAfter(/databases/$(database)/documents/lobbies/$(gameId)/iron_throne/state).data.stateVersion == b.stateVersion)
            || fields.hasOnly(['phase']) && a.phase == 'planning' && b.phase == 'resolving');
      }
      function ironMetaUpdate() {
        let a=resource.data; let b=request.resource.data; let fields=b.diff(a).affectedKeys();
        // Route by the changed fields so invalid requests cannot exhaust the rule
        // expression budget by evaluating every unrelated operation.
        return fields.hasOnly(['seats','ready']) ? ironClaimUpdate(a,b)
          : fields.hasOnly(['options']) ? a.phase == 'setup' && a.hostUid == request.auth.uid
          : fields.hasOnly(['lease','epoch','hostUid']) ? ironLeaseUpdate(a,b)
          : a.phase == 'setup' ? ironStartUpdate(a,b) : ironCommitUpdate(a,b,fields);
      }
      match /iron_throne/{docId} {
        allow read: if ironMember() && (docId in ['meta','world'] || docId == 'state' && (ironController() || ironMeta().phase == 'setup' && ironMeta().hostUid == request.auth.uid));
        allow create: if docId == 'meta' && ironMember() && request.resource.data.hostUid == ironLobby().hostUid
          && request.resource.data.phase == 'setup' && request.resource.data.stateVersion == 0 && request.resource.data.epoch == 0
          && request.resource.data.turn == 0 && request.resource.data.lease == null
          && request.resource.data.seats.keys().hasOnly(['ashen','wintermere','thornwall','sunspire','vesper','redharbor'])
          && request.resource.data.seats.values().hasOnly([{'kind':'open','uid':null,'name':''}]);
        allow update: if docId == 'meta' && ironMember() && ironMetaUpdate();
        allow create: if docId in ['state','world'] && ironSnapshotWrite() && request.resource.data.stateVersion == 1;
        allow update: if docId in ['state','world'] && ironSnapshotWrite() && request.resource.data.stateVersion == resource.data.stateVersion + 1;
      }
      match /iron_throne_private/{houseId} {
        allow read: if ironHouse(houseId) && ironMember() && (ironSeat(ironMeta(),houseId) || ironController());
        allow create: if ironHouse(houseId) && ironSnapshotWrite() && request.resource.data.stateVersion == 1;
        allow update: if ironHouse(houseId) && ironSnapshotWrite() && request.resource.data.stateVersion == resource.data.stateVersion + 1;
      }
      match /iron_throne_presence/{uid} {
        allow read: if ironMember();
        allow create, update: if ironMember() && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid','name','at']) && request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string && request.resource.data.name.size() <= 40 && request.resource.data.at == request.time;
      }
      match /iron_throne_commands/{commandId} {
        allow get: if ironMember() && (!exists(/databases/$(database)/documents/lobbies/$(gameId)/iron_throne_commands/$(commandId))
          || resource.data.uid == request.auth.uid || ironController());
        allow list: if ironMember() && (resource.data.uid == request.auth.uid || ironController());
        allow create: if ironMember() && request.resource.data.uid == request.auth.uid && request.resource.data.id == commandId
          && request.resource.data.keys().hasOnly(['id','clientId','sequence','uid','actorHouseId','turn','stateVersion','epoch','activationId','type','args','status','createdAt'])
          && ironSeat(ironMeta(),request.resource.data.actorHouseId) && !ironMeta().seats[request.resource.data.actorHouseId].substitute
          && ((ironMeta().phase == 'founding' && request.resource.data.type == 'found')
            || (ironMeta().phase == 'planning' && request.resource.data.type != 'found'
              && (request.resource.data.type in ['read','councilRead','takeover']
                || (request.resource.data.activationId == ironMeta().activationId && request.resource.data.actorHouseId == ironMeta().activeHouse))))
          && request.resource.data.turn == ironMeta().turn && request.resource.data.epoch == ironMeta().epoch
          && request.resource.data.stateVersion is int && request.resource.data.stateVersion >= 1 && request.resource.data.stateVersion <= ironMeta().stateVersion
          && request.resource.data.sequence is int && request.resource.data.sequence > 0 && request.resource.data.clientId is string && request.resource.data.clientId.size() <= 64
          && request.resource.data.type in ['royalDecree','formalSubmit','formalRatify','formalDismiss','formalConsider','formalResolve','formalAnswer','formalRetryVoice','formalVoice','shipBuild','shipCancel','fleetEmbark','fleetOrder','fleetMerge','reorganize','generalHire','generalAssign','generalDetach','generalOrder','generalChat','vassalCommand','vassalAccept','endActivation','councilOpen','councilBegin','councilConsider','councilCommit','councilRetry','councilFinalize','councilChat','councilVoice','councilRead','operationCreate','operationAnswer','operationSupply','operationLeave','cooperationAnswer','found','build','highway','recruit','order','structure','split','merge','formation','tax','recruitSpy','assignSpy','ransom','captive','recruitAmbassador','assignAmbassador','ambassadorIncident','deliver','ratify','declineTrade','chat','humanProposal','respondProposal','read','ready','takeover']
          && request.resource.data.args is map && request.resource.data.args.size() <= 12 && request.resource.data.status == 'pending' && request.resource.data.createdAt == request.time;
        allow update: if ironController() && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','error','stateVersionApplied','resolvedAt'])
          && request.resource.data.status in ['accepted','rejected'] && request.resource.data.resolvedAt == request.time;
      }
      match /iron_throne_snapshots/{slot} {
        allow read: if ironController();
        allow write: if slot in ['0','1','2'] && ironSnapshotWrite();
      }


      match /crowncouncil/{docId} {
        allow read, write: if isAuthed() && !turncraftType(ironLobby()) && (!forgeLobbyType(ironLobby())
          || ironLobby().get('hostUid','') == '' || request.auth.uid in ironLobby().members);
      }

      match /alliances/{allianceId} {
        allow read, write: if isAuthed() && !turncraftType(ironLobby());
      }

      match /highscores/{scoreId} {
        allow read: if isAuthed() && gameId == 'world_quest';
        allow create: if gameId == 'world_quest' && validCountryQuestScore();
        allow update: if gameId == 'world_quest'
          && validCountryQuestScore()
          && resource.data.uid == request.auth.uid
          && request.resource.data.score >= resource.data.score;
        allow delete: if gameId == 'world_quest'
          && isAuthed()
          && resource.data.uid == request.auth.uid;
      }

      // Grass Realms and War Realms keep their synchronized match snapshot on
      // this lobby document and authenticated readiness/deck data in presence/{uid}.
      // Academy and other lobby-backed games also use authenticated subcollections.
      match /{subcollection}/{document=**} {
        allow read, write: if isAuthed() && gameId != 'world_quest'
          && (!turncraftType(ironLobby()) || ironLobby().get('turncraftVersion',0) != 1)
          && !(subcollection in ['crowncouncil','iron_throne','iron_throne_private','iron_throne_presence','iron_throne_commands','iron_throne_snapshots','iron_throne_threads']);
      }
    }

    match /gameStats/{gameId} {
      allow read, write: if isAuthed();
    }

    // Community chat is split so Firestore can enforce private visibility.
    // Public messages are readable by signed-in visitors and become deletable
    // after the same 24-hour retention window used by the client.
    match /chat/{messageId} {
      allow read: if isAuthed();
      allow create: if isAuthed()
        && request.resource.data.username is string
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 500
        && request.resource.data.type in ['message', 'lobby_ad'];
      allow update: if false;
      allow delete: if isAuthed()
        && resource.data.timestamp < request.time - duration.value(24, 'h');
    }

    // Each private document carries the two Firebase Auth UIDs. Queries must
    // use array-contains(request.auth.uid), allowing rules to prove that every
    // returned message belongs to the current participant.
    match /privateChat/{messageId} {
      allow read: if isAuthed()
        && request.auth.uid in resource.data.participantUids;
      allow create: if isAuthed()
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.recipientUid is string
        && request.resource.data.participantUids is list
        && request.resource.data.participantUids.size() == 2
        && request.auth.uid in request.resource.data.participantUids
        && request.resource.data.username is string
        && request.resource.data.privateTo is string
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 500
        && request.resource.data.type == 'private';
      allow update: if false;
      allow delete: if isAuthed()
        && request.auth.uid in resource.data.participantUids
        && resource.data.timestamp < request.time - duration.value(24, 'h');
    }

    match /metrics_dailyUsers/{dateKey} {
      match /users/{uid} {
        allow read, write: if isAuthed();
      }
    }

    match /grid_overlord_games/{gameId} {
      allow read, write: if isAuthed();

      match /players/{playerId} {
        allow read: if isAuthed();
        allow write: if isAuthed() && request.auth.uid == playerId;
      }

      match /nodes/{nodeId} {
        allow read, write: if isAuthed();
      }
    }

    match /castlepanic_games/{gameId} {
      allow read, write: if isAuthed();

      match /players/{playerId} {
        allow read: if isAuthed();
        allow write: if isAuthed() && request.auth.uid == playerId;
      }

      match /nodes/{nodeId} {
        allow read, write: if isAuthed();
      }
    }

    match /micromon_saves/{saveId} {
      allow read, write: if isAuthed();
    }

    match /mqUsers/{username} {
      allow read, write: if isAuthed();
    }

    match /games_rogueduel/{gameId} {
      allow read, write: if isAuthed();

      match /{sub=**} {
        allow read, write: if isAuthed();
      }
    }

    match /games_basewar/{gameId} {
      allow read, write: if isAuthed();

      match /commands/{cmdId} {
        allow read, write: if isAuthed();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
