rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed() {
      return request.auth != null;
    }

    function forgeDeckAllowed(faction) {
      return faction == 'Vanir' ? ['rifleman','vrocket','vguard','miner','medic','suppressor','shieldcap','marksman','emp','signalhawk','railbreaker']
        : faction == 'Aesir' ? ['phaser','blade','storm','guardian','wardmaker','architect','golem','runebinder','chronoweaver','miragewarden']
        : faction == 'Helions' ? ['hellspawn','roach','defiler','blood','spitter','matron','viper','carrion','burrower','siphonleech','hiveherald'] : [];
    }
    function forgeDeckUnlocked(profile,key) { return profile.troops[key].unlocked == true; }
    function forgeDeckShape(deck) {
      return deck is map && deck.keys().hasOnly(['id','name','faction','troops'])
        && deck.id is string && deck.id.matches('^[A-Za-z0-9_-]{1,80}$')
        && deck.name is string && deck.name.size() >= 1 && deck.name.size() <= 48
        && deck.faction in ['Vanir','Aesir','Helions'] && deck.troops is list && deck.troops.size() == 5
        && deck.troops.toSet().size() == 5 && deck.troops.toSet().difference(forgeDeckAllowed(deck.faction).toSet()).size() == 0;
    }
    function forgeValidDeck(deck,profile) {
      return forgeDeckShape(deck) && forgeDeckCollectionUnlocked(deck,profile);
    }
    function forgeDeckCollectionUnlocked(deck,profile) {
      return forgeDeckUnlocked(profile,deck.troops[0]) && forgeDeckUnlocked(profile,deck.troops[1])
        && forgeDeckUnlocked(profile,deck.troops[2]) && forgeDeckUnlocked(profile,deck.troops[3]) && forgeDeckUnlocked(profile,deck.troops[4]);
    }
    function forgeValidDeckAt(profile,index) {
      let previous=resource == null ? [] : resource.data.get('decks',[]);
      return profile.decks.size() <= index || (previous.size() > index && profile.decks[index] == previous[index]) || forgeValidDeck(profile.decks[index],profile);
    }
    function forgeDeckSelectedAt(profile,index) { return profile.decks.size() > index && profile.decks[index].id == profile.selectedDeckId; }
    function forgeDeckImport(profile) {
      let root=/databases/$(database)/documents/factionForgeSoloProfiles/$(request.auth.uid);
      let key=profile.get('deckImportAccountKey','');
      return exists(root) && get(root).data.get('decks',[]) == profile.decks
        || key is string && key.matches('^name-[^/]{1,240}$')
          && exists(/databases/$(database)/documents/factionForgeSoloProfiles/$(request.auth.uid)/accounts/$(key))
          && get(/databases/$(database)/documents/factionForgeSoloProfiles/$(request.auth.uid)/accounts/$(key)).data.get('decks',[]) == profile.decks;
    }
    function forgeDeckFields(profile) {
      let previous=resource == null ? [] : resource.data.get('decks',[]);
      let index=profile.get('selectedDeckIndex',0);
      // Legacy saves can gain deck defaults without losing their progress. Once
      // migrated, a stale save must not erase the player's saved deck library.
      return !profile.keys().hasAny(['decks','selectedDeckId','selectedDeckIndex']) ? previous.size() == 0 : (
        profile.decks is list && profile.decks.size() >= 3 && profile.decks.size() <= 12 && profile.selectedDeckId is string
        && index is int && index >= 0 && index < profile.decks.size() && profile.selectedDeckId == profile.decks[index].id
        && profile.decks[0] == {'id':'starter-vanir','name':'Iron Vanguard','faction':'Vanir','troops':['vguard','marksman','suppressor','vrocket','medic']}
        && profile.decks[1] == {'id':'starter-aesir','name':'Arcane Tempest','faction':'Aesir','troops':['guardian','phaser','storm','runebinder','wardmaker']}
        && profile.decks[2] == {'id':'starter-helions','name':'Blight Swarm','faction':'Helions','troops':['hellspawn','roach','defiler','spitter','blood']}
        && (profile.decks == previous
          || previous.size() == 0 && (profile.decks.size() == 3 || forgeDeckImport(profile))
          || index >= 3 && forgeValidDeck(profile.decks[index],profile) && (
            profile.decks.size() == previous.size()+1 && index == previous.size() && profile.decks.removeAll([profile.decks[index]]) == previous
            || profile.decks.size() == previous.size() && profile.decks.removeAll([profile.decks[index]]) == previous.removeAll([previous[index]]))));
    }

    // MOUNTAIN BLADE ONLINE — FIRESTORE-ONLY MULTIPLAYER
    // Place inside match /databases/{database}/documents. Uses isAuthed().
    // A leased player browser simulates the realm. No Admin SDK / Node service.
    function moLease() {
      return get(/databases/$(database)/documents/mountOnlineRealms/living-realm).data;
    }
    function moHost() {
      return isAuthed() && moLease().ownerUid == request.auth.uid
        && moLease().released == false
        && moLease().renewedAt + duration.value(20, 's') > request.time;
    }
    function moHostFor(uid) {
      return moHost()
        && exists(/databases/$(database)/documents/mountOnlineRealms/living-realm/sessions/$(uid));
    }
    function moBlob(data) {
      return data.hostSession == moLease().ownerSession
        && data.epoch == moLease().epoch
        && data.packed is string && data.packed.size() <= 850000
        && data.updatedAt == request.time;
    }
    function moProfile(data, uid) {
      return data.uid == uid && data.schemaVersion == 2
        && data.username is string && data.username.size() >= 1 && data.username.size() <= 40
        && data.gold is number && data.gold >= 0 && data.gold <= 1000000000000
        && data.level is int && data.level >= 1 && data.level <= 100
        && data.xp is number && data.xp >= 0
        && data.x is number && data.x >= 0 && data.x < 320
        && data.y is number && data.y >= 0 && data.y < 224
        && data.army is map && data.army.size() in [14, 34]
        && data.reserve is map && data.reserve.size() in [14, 34]
        && data.inventory is map && data.stats is map && data.skills is map
        && data.achievements is list && data.claimedContracts is list
        && data.keys().hasOnly(['schemaVersion','username','gold','supplies','renown','level','xp','army','reserve','x','y','morale','inventory','achievements','stats','relations','skills','skillPoints','contracts','claimedContracts','explored','activeBattle','revision','lastIncome','uid','linked','migrated','legacyHoldings','legacyInventory','legacyAllegiance','route','routeIndex','readyAt','battleCooldown','px','py','lastBattle','allianceId','economyClock','playTime','diplomacy','worldVersion']);
    }
    match /mountOnlineProfiles/{uid} {
      allow get: if isAuthed() && (request.auth.uid == uid || moHostFor(uid));
      allow create, update: if moHostFor(uid) && moProfile(request.resource.data, uid);
      allow list, delete: if false;
      match /receipts/{id} { allow read, write: if false; }
    }
    // Optional legacy bindings are entered in the Firebase Console after
    // verifying the account owner. Browser clients cannot claim another name.
    match /mountOnlineAccounts/{uid} {
      allow get: if isAuthed() && (request.auth.uid == uid || moHostFor(uid));
      allow list, write: if false;
    }
    match /mountOnlineNames/{username} {
      allow get: if isAuthed();
      allow list, write: if false;
    }
    // Previous server-only collections stay locked; they are not used by this client.
    match /mountOnlineRealm/{id} { allow read, write: if false; }
    match /mountOnlineBattles/{id} { allow read, write: if false; }

    match /mountOnlineRealms/{realmId} {
      function living() { return realmId == 'living-realm'; }
      function validLease() {
        let data = request.resource.data;
        return isAuthed() && living()
          && data.keys().hasAll(['schemaVersion','ownerUid','ownerSession','epoch','released','renewedAt'])
          && data.keys().hasOnly(['schemaVersion','ownerUid','ownerSession','epoch','released','renewedAt'])
          && data.schemaVersion == 1 && data.ownerUid == request.auth.uid
          && data.ownerSession is string && data.ownerSession.size() <= 80
          && data.ownerSession == get(/databases/$(database)/documents/mountOnlineRealms/living-realm/sessions/$(request.auth.uid)).data.sessionId
          && data.epoch is int && data.epoch > 0
          && data.released is bool && data.renewedAt == request.time;
      }
      allow get: if isAuthed() && living();
      allow create: if validLease() && request.resource.data.epoch == 1
        && request.resource.data.released == false;
      allow update: if validLease() && (
        (resource.data.ownerUid == request.auth.uid
          && resource.data.ownerSession == request.resource.data.ownerSession
          && request.resource.data.epoch == resource.data.epoch)
        || (request.resource.data.released == false
          && request.resource.data.epoch == resource.data.epoch + 1
          && (resource.data.released == true || resource.data.ownerUid == request.auth.uid
            || resource.data.renewedAt + duration.value(20, 's') <= request.time)));
      allow list, delete: if false;

      match /sessions/{uid} {
        allow read: if isAuthed() && living();
        allow create, update: if isAuthed() && living() && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid','sessionId','username','seenAt'])
          && request.resource.data.uid == uid
          && request.resource.data.sessionId is string && request.resource.data.sessionId.size() >= 8 && request.resource.data.sessionId.size() <= 80
          && request.resource.data.username is string && request.resource.data.username.size() >= 1 && request.resource.data.username.size() <= 40
          && request.resource.data.seenAt == request.time;
        allow delete: if false;
      }
      match /state/{id} {
        allow get: if living() && moHost();
        allow create: if living() && id == 'checkpoint' && moHost()
          && moBlob(request.resource.data) && request.resource.data.revision == 1
          && request.resource.data.schemaVersion == 1
          && request.resource.data.keys().hasOnly(['schemaVersion','epoch','hostSession','revision','packed','updatedAt']);
        allow update: if living() && id == 'checkpoint' && moHost()
          && moBlob(request.resource.data) && request.resource.data.revision == resource.data.revision + 1
          && request.resource.data.schemaVersion == 1
          && request.resource.data.keys().hasOnly(['schemaVersion','epoch','hostSession','revision','packed','updatedAt']);
        allow list, delete: if false;
      }
      match /views/{uid} {
        allow get: if isAuthed() && living() && (uid == request.auth.uid || moHost());
        allow create, update: if living() && moHostFor(uid)
          && request.resource.data.uid == uid && moBlob(request.resource.data)
          && request.resource.data.keys().hasOnly(['uid','epoch','hostSession','packed','updatedAt']);
        allow list, delete: if false;
      }
      match /commands/{id} {
        allow get: if isAuthed() && living()
          && (resource == null || resource.data.uid == request.auth.uid || moHost());
        allow list: if living() && moHost();
        allow create: if isAuthed() && living()
          && id.matches('^[A-Za-z0-9_-]{8,80}$')
          && request.resource.data.keys().hasOnly(['uid','sessionId','type','payload','state','createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.sessionId == get(/databases/$(database)/documents/mountOnlineRealms/living-realm/sessions/$(request.auth.uid)).data.sessionId
          && request.resource.data.state == 'pending' && request.resource.data.createdAt == request.time
          && request.resource.data.type in ['move','command','halt','engage','recruit','train','reserve','supplies','rest','buyBanner','equip','contract','skill','build','garrison','diplomacy','caravan','allianceCreate','allianceRequest','allianceAccept','allianceLeave']
          && request.resource.data.payload is map && request.resource.data.payload.size() <= 16
          && request.resource.data.payload.type == request.resource.data.type
          && request.resource.data.payload.keys().hasOnly(['type','point','order','ids','formation','target','ability','kind','settlement','count','unit','withdraw','item','skill','faction','peace','id','name','alliance','member','action','gold','offerId','demand'])
          && (!('gold' in request.resource.data.payload) || (request.resource.data.type == 'diplomacy' && request.resource.data.payload.gold is int && request.resource.data.payload.gold >= 0 && request.resource.data.payload.gold <= 100000))
          && (!('action' in request.resource.data.payload) || (request.resource.data.type == 'diplomacy' && request.resource.data.payload.action is string && request.resource.data.payload.action.size() <= 32))
          && (!('offerId' in request.resource.data.payload) || (request.resource.data.type == 'diplomacy' && request.resource.data.payload.offerId is string && request.resource.data.payload.offerId.size() <= 16))
          && (!('demand' in request.resource.data.payload) || (request.resource.data.type == 'diplomacy' && request.resource.data.payload.demand is bool))
          && (!('ids' in request.resource.data.payload) || (request.resource.data.payload.ids is list && request.resource.data.payload.ids.size() <= 600));
        allow update: if living() && moHost() && resource.data.state == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state','result','epoch','handledAt'])
          && request.resource.data.state in ['done','error']
          && request.resource.data.result is map && request.resource.data.result.keys().hasOnly(['ok','message'])
          && request.resource.data.result.ok is bool
          && request.resource.data.epoch == moLease().epoch
          && request.resource.data.handledAt == request.time;
        // Durable command receipts stay immutable to prevent replayed rewards.
        allow delete: if isAuthed() && living() && resource.data.uid == request.auth.uid
          && resource.data.state in ['done','error'] && resource.data.type in ['move','command','halt'];
      }
    }

    function turncraftType(data) { return data.get('gameType','') == 'turncraft'; }
    // Previous server-owned competitive collections remain read-only. Account
    // progress and immutable match receipts use the existing username profile.
    match /turncraftProfiles/{uid} {
      allow get: if isAuthed() && request.auth.uid == uid;
      allow list, write: if false;
      match /{subcollection}/{recordId} {
        allow read: if isAuthed() && request.auth.uid == uid && subcollection == 'history';
        allow write: if false;
      }
    }
    match /turncraftRankings/{uid} { allow read: if isAuthed(); allow write: if false; }
    match /turncraftMatches/{id} { allow read, write: if false; match /{sub=**} { allow read, write: if false; } }
    // Old invitation paths are retired; all live match infrastructure is lobby-scoped.
    match /turncraftInvites/{code} { allow read, write: if false; }
    match /turncraftLobbySecrets/{id} { allow read, write: if false; }
    match /turncraftLobbyJoins/{id}/members/{uid} { allow read, write: if false; }
    match /turncraftLobbyRequests/{id} { allow read, write: if false; }
    match /turncraftRatingPairs/{id} { allow read, write: if false; }
    match /turncraftRankedQueue/{uid} { allow read, write: if false; }
    function turncraftPersonalProgress(data) {
      let campaign = data.get('campaign', {});
      let survival = data.get('survival', {});
      return campaign is map && survival is map
        && campaign.get('completedMissions', {}) is map
        && campaign.get('completedMissions', {}).size() <= 24
        && campaign.get('highestCompletedMission', 0) is int
        && campaign.get('highestCompletedMission', 0) >= 0
        && campaign.get('highestCompletedMission', 0) <= 24
        && campaign.get('unlockedRegions', []) is list
        && campaign.get('unlockedRegions', []).size() <= 6
        && survival.get('recordsByMap', {}) is map
        && survival.get('recordsByMap', {}).size() <= 24
        && survival.get('highestWave', 0) is int
        && survival.get('highestWave', 0) >= 0
        && survival.get('highestWave', 0) <= 100000
        && data.get('achievements', {}) is map
        && data.get('achievements', {}).size() <= 64;
    }
    function turncraftProfileCreate() {
      let next = request.resource.data.get('gameStats', {}).get('turncraft', {});
      return next is map && next.keys().hasOnly(['campaign','survival','achievements'])
        && turncraftPersonalProgress(next);
    }
    function turncraftRank(mmr) {
      return mmr >= 1750 ? 'Master' : mmr >= 1500 ? 'Diamond' : mmr >= 1300 ? 'Platinum'
        : mmr >= 1100 ? 'Gold' : mmr >= 900 ? 'Silver' : 'Bronze';
    }
    function turncraftParticipant(lobby,username) {
      let seats=lobby.turncraftSeats;
      return lobby.members[seats[0]] == username ? seats[0]
        : seats.size() > 1 && lobby.members[seats[1]] == username ? seats[1]
        : seats.size() > 2 && lobby.members[seats[2]] == username ? seats[2]
        : seats.size() > 3 && lobby.members[seats[3]] == username ? seats[3] : '';
    }
    function turncraftOutcome(lobby,username) {
      let winner=lobby.turncraftResult.winnerIdx;
      return winner == null ? 'draw' : winner < lobby.turncraftSeats.size() && lobby.members[lobby.turncraftSeats[winner]] == username ? 'win' : 'loss';
    }
    function turncraftOpponents(lobby,username) {
      let players=lobby.turncraftResult.players;
      let own=lobby.members[lobby.turncraftSeats[0]] == username ? 0 : lobby.members[lobby.turncraftSeats[1]] == username ? 1
        : lobby.turncraftSeats.size() > 2 && lobby.members[lobby.turncraftSeats[2]] == username ? 2 : 3;
      return (own == 0 ? [] : [players[0].name])
        .concat(own == 1 ? [] : [players[1].name])
        .concat(players.size() <= 2 || own == 2 ? [] : [players[2].name])
        .concat(players.size() <= 3 || own == 3 ? [] : [players[3].name]);
    }
    function turncraftReceipt(username,id,data) {
      let lobby=get(/databases/$(database)/documents/lobbies/$(id)).data;
      let old=get(/databases/$(database)/documents/users/$(username)).data.get('gameStats',{}).get('turncraft',{});
      let before=old.get('mmr',1000);
      let outcome=turncraftOutcome(lobby,username);
      let ranked=lobby.ranked;
      let raw=before+(ranked ? (outcome == 'win' ? 25 : outcome == 'loss' ? -25 : 0) : 0);
      let after=raw < 0 ? 0 : raw;
      let uid=turncraftParticipant(lobby,username);
      return isAuthed() && lobby.gameType == 'turncraft' && lobby.turncraftVersion == 1 && lobby.status == 'finished'
        && uid != '' && lobby.members[uid] == username
        && lobby.turncraftPlayers[uid].name == username
        && (!ranked || lobby.turncraftSeats.size() == 2 && lobby.turncraftResult.players.size() == 2
          && lobby.settings.maxPlayers == 2 && lobby.settings.get('fillAi',false) == false)
        && data.keys().hasOnly(['id','lobbyId','uid','username','mode','outcome','winnerIdx','factionId','opponents','mapId','gameMode','durationSeconds','completedAt','mmrBefore','mmrAfter','mmrDelta'])
        && data.id == id && data.lobbyId == id && data.uid == uid && data.username == username
        && data.mode == (ranked ? 'ranked' : 'custom') && data.outcome == outcome
        && data.winnerIdx == lobby.turncraftResult.winnerIdx && data.factionId == lobby.turncraftPlayers[uid].factionId
        && data.opponents == turncraftOpponents(lobby,username) && data.mapId == lobby.settings.mapId && data.gameMode == lobby.settings.gameMode
        && data.durationSeconds == lobby.turncraftResult.durationSeconds && data.completedAt == lobby.finishedAt
        && data.mmrBefore == before && data.mmrAfter == after && data.mmrDelta == after-before;
    }
    function turncraftStatsDelta(old,next,receipt) {
      let ranked=receipt.mode == 'ranked';let won=receipt.outcome == 'win';let lost=receipt.outcome == 'loss';let draw=receipt.outcome == 'draw';
      let matches=old.get('rankedMatches',0)+(ranked ? 1 : 0);
      let highest=old.get('highestMMR',1000) > old.get('mmr',1000) ? old.get('highestMMR',1000) : old.get('mmr',1000);
      return next.diff(old).affectedKeys().hasOnly(['campaign','survival','achievements','lastMatchId','multiplayerMatches','multiplayerWins','multiplayerLosses','multiplayerDraws','mmr','rank','rankedMatches','rankedWins','rankedLosses','rankedDraws','highestMMR','provisionalMatchesRemaining'])
        && turncraftPersonalProgress(next)
        && next.multiplayerMatches == old.get('multiplayerMatches',0)+1
        && next.multiplayerWins == old.get('multiplayerWins',0)+(won ? 1 : 0)
        && next.multiplayerLosses == old.get('multiplayerLosses',0)+(lost ? 1 : 0)
        && next.multiplayerDraws == old.get('multiplayerDraws',0)+(draw ? 1 : 0)
        && (ranked ? next.mmr == receipt.mmrAfter && next.rank == turncraftRank(receipt.mmrAfter)
          && next.rankedMatches == matches && next.rankedWins == old.get('rankedWins',0)+(won ? 1 : 0)
          && next.rankedLosses == old.get('rankedLosses',0)+(lost ? 1 : 0)
          && next.rankedDraws == old.get('rankedDraws',0)+(draw ? 1 : 0)
          && next.highestMMR == (highest > receipt.mmrAfter ? highest : receipt.mmrAfter)
          && next.provisionalMatchesRemaining == (matches < 10 ? 10-matches : 0)
          : next.get('mmr',1000) == old.get('mmr',1000) && next.get('rank','Unranked') == old.get('rank','Unranked')
            && next.get('rankedMatches',0) == old.get('rankedMatches',0) && next.get('rankedWins',0) == old.get('rankedWins',0)
            && next.get('rankedLosses',0) == old.get('rankedLosses',0) && next.get('rankedDraws',0) == old.get('rankedDraws',0)
            && next.get('highestMMR',1000) == old.get('highestMMR',1000)
            && next.get('provisionalMatchesRemaining',10) == old.get('provisionalMatchesRemaining',10));
    }
    function turncraftMatchProfileUpdate(username,old,next) {
      let id=next.get('lastMatchId','');
      let path=/databases/$(database)/documents/users/$(username)/turncraftHistory/$(id);
      let receipt=getAfter(path).data;
      return id is string && id.size() >= 1 && id.size() <= 100 && !exists(path)
        && turncraftReceipt(username,id,receipt) && turncraftStatsDelta(old,next,receipt);
    }
    function turncraftProfileUpdate(username) {
      let old = resource.data.get('gameStats', {}).get('turncraft', {});
      let next = request.resource.data.get('gameStats', {}).get('turncraft', {});
      return next is map && old is map
        && (next == old || (next.diff(old).affectedKeys().hasOnly(['campaign','survival','achievements'])
          && turncraftPersonalProgress(next)) || turncraftMatchProfileUpdate(username,old,next));
    }

    function isGridboundPersistentCreate() {
      return request.resource.data.keys().hasOnly([
          'persistentState',
          'persistentUpdatedAt',
          'activeCombatMigratedToRTDB',
          'activeCombatDatabase',
          'activeCombatSchemaVersion',
          'migratedAt'
        ])
        && request.resource.data.keys().hasAll([
          'activeCombatMigratedToRTDB',
          'activeCombatDatabase',
          'activeCombatSchemaVersion'
        ])
        && request.resource.data.activeCombatMigratedToRTDB == true
        && request.resource.data.activeCombatDatabase == 'realtime-database'
        && request.resource.data.activeCombatSchemaVersion == 3
        && request.resource.data.get('persistentState', {}) is map
        && request.resource.data.get('persistentUpdatedAt', request.time) is timestamp
        && request.resource.data.get('migratedAt', request.time) is timestamp;
    }

    function isGridboundPersistentUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'persistentState',
          'persistentUpdatedAt',
          'activeCombatMigratedToRTDB',
          'activeCombatDatabase',
          'activeCombatSchemaVersion',
          'migratedAt'
        ])
        && request.resource.data.activeCombatMigratedToRTDB == true
        && request.resource.data.activeCombatDatabase == 'realtime-database'
        && request.resource.data.activeCombatSchemaVersion == 3
        && request.resource.data.get('persistentState', {}) is map
        && request.resource.data.get('persistentUpdatedAt', request.time) is timestamp
        && request.resource.data.get('migratedAt', request.time) is timestamp;
    }

    function validRewardCreate(rewardId) {
      return request.resource.data.keys().hasOnly([
          'id',
          'uid',
          'username',
          'realmId',
          'roomId',
          'activeRoomKey',
          'controllerUid',
          'sourceAttackId',
          'enemyId',
          'enemyType',
          'eliteAffix',
          'isBoss',
          'xp',
          'gold',
          'restoredStolenGold',
          'item',
          'materials',
          'relicId',
          'claimed',
          'createdAtMs',
          'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'id',
          'uid',
          'username',
          'realmId',
          'roomId',
          'activeRoomKey',
          'controllerUid',
          'sourceAttackId',
          'enemyId',
          'enemyType',
          'isBoss',
          'xp',
          'gold',
          'restoredStolenGold',
          'materials',
          'claimed',
          'createdAtMs',
          'createdAt'
        ])
        && request.resource.data.id == rewardId
        && request.resource.data.controllerUid == request.auth.uid
        && request.resource.data.uid is string
        && request.resource.data.uid.size() > 0
        && request.resource.data.username is string
        && request.resource.data.username.size() <= 64
        && request.resource.data.realmId is string
        && request.resource.data.realmId.size() <= 128
        && request.resource.data.roomId is string
        && request.resource.data.roomId.size() <= 128
        && request.resource.data.activeRoomKey is string
        && request.resource.data.activeRoomKey.size() <= 260
        && request.resource.data.sourceAttackId is string
        && request.resource.data.sourceAttackId.size() <= 192
        && request.resource.data.enemyId is string
        && request.resource.data.enemyId.size() <= 192
        && request.resource.data.enemyType is string
        && request.resource.data.enemyType.size() <= 96
        && (request.resource.data.get('eliteAffix', null) == null
            || request.resource.data.get('eliteAffix', null) is string);
    }

    function validRewardNumbersAndPayload() {
      return request.resource.data.isBoss is bool
        && request.resource.data.xp is int
        && request.resource.data.xp >= 0
        && request.resource.data.xp <= 100000
        && request.resource.data.gold is int
        && request.resource.data.gold >= 0
        && request.resource.data.gold <= 100000
        && request.resource.data.restoredStolenGold is int
        && request.resource.data.restoredStolenGold >= 0
        && request.resource.data.restoredStolenGold <= 100000
        && (request.resource.data.get('item', null) == null
            || request.resource.data.get('item', null) is map);
    }

    function validRewardOptionalPayload() {
      return request.resource.data.materials is map
        && request.resource.data.materials.size() <= 16
        && (request.resource.data.get('relicId', null) == null
            || request.resource.data.get('relicId', null) is string)
        && request.resource.data.claimed == false
        && request.resource.data.createdAtMs is int
        && request.resource.data.createdAtMs >= request.time.toMillis() - 10000
        && request.resource.data.createdAtMs <= request.time.toMillis() + 10000
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt == request.time;
    }


    function validCountryQuestScore() {
      return isAuthed()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 20
        && request.resource.data.category in [
          'map_easy_lives', 'map_easy_timed',
          'map_hard_lives', 'map_hard_timed',
          'flag_easy_lives', 'flag_easy_timed',
          'flag_hard_lives', 'flag_hard_timed',
          'flagmap_easy_lives', 'flagmap_easy_timed',
          'flagmap_hard_lives', 'flagmap_hard_timed',
          'distance_easy_score', 'distance_hard_score',
          'stats_easy_score', 'stats_hard_score',
          'map_lives', 'map_timed',
          'flag_lives', 'flag_timed',
          'flagmap_lives', 'flagmap_timed',
          'regions_score', 'stats_score'
        ]
        && request.resource.data.gameMode in ['map', 'distance', 'flag', 'flagmap', 'regions', 'stats']
        && request.resource.data.challengeMode in ['lives', 'timed', 'score']
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.maxScore is int
        && request.resource.data.maxScore >= 1
        && request.resource.data.maxScore <= 2000000000
        && request.resource.data.score <= request.resource.data.maxScore
        && request.resource.data.correct is int
        && request.resource.data.correct >= 0
        && request.resource.data.correct <= request.resource.data.total
        && request.resource.data.total is int
        && request.resource.data.total >= 25
        && request.resource.data.total <= 300
        && request.resource.data.mistakes is int
        && request.resource.data.mistakes >= 0
        && request.resource.data.elapsedMs is int
        && request.resource.data.elapsedMs >= 0
        && request.resource.data.penaltyMs is int
        && request.resource.data.penaltyMs >= 0
        && request.resource.data.completed is bool
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'category', 'gameMode', 'challengeMode',
          'score', 'maxScore', 'correct', 'total', 'mistakes', 'elapsedMs',
          'penaltyMs', 'completed', 'updatedAt'
        ]);
    }

    // New authority collections are never covered by a legacy recursive grant.
    // Binding records are provisioned only by Firebase Admin after owner recovery.
    // Personal campaign/Forge saves are separate from competitive authority.
    // Firebase Auth owns each save; other players cannot read or change it.
    match /factionForgeSoloProfiles/{uid} {
      function ownsSoloSave() { return isAuthed() && request.auth.uid == uid; }
      function validSoloSave() {
        let data=request.resource.data;
        return ownsSoloSave() && data.uid == uid && data.schemaVersion == 1
          && data.username is string && data.username.size() >= 1 && data.username.size() <= 80
          && data.forgeDust is int && data.forgeDust >= 0
          && data.troops is map && data.troops.size() == 32
          && data.campaign is map && data.campaign.missions is map && data.campaign.missions.size() <= 30
          && data.campaign.endlessUnlocked is bool && data.campaign.endlessBest is int && data.campaign.endlessBest >= 0
          && data.wins is int && data.wins >= 0 && data.losses is int && data.losses >= 0
          && (data.rewardTarget == null || data.rewardTarget is string)
          && data.rewardDay is string && data.rewardCounts is map
          && data.updatedAt is int && data.updatedAt >= 0
          && forgeDeckFields(data)
          && data.keys().hasOnly(['schemaVersion','uid','username','forgeDust','troops','campaign','wins','losses','rewardTarget','rewardDay','rewardCounts','updatedAt','decks','selectedDeckId','selectedDeckIndex','deckImportAccountKey']);
      }
      function validSoloReceipt(kind,id) {
        let data=request.resource.data;
        return ownsSoloSave() && data.uid == uid && (
          (kind == 'results' && data.id == id && data.mode in ['campaign','bot','endless']
            && data.keys().hasOnly(['id','uid','mode','won','missionId','stars','cards','forgeDust','unlocks','completedAt']))
          || (kind == 'upgrades' && data.requestId == id
            && data.keys().hasOnly(['uid','requestId','troopKey','fromTier','toTier','cardsSpent','dustSpent','completedAt']))
          || (kind == 'purchases' && data.requestId == id && data.packId in ['vanir','aesir','helions','war-chest','random-reinforcements']
            && data.dustSpent == (data.packId == 'war-chest' ? 90 : 50)
            && data.cards is list && data.cards.size() == (data.packId == 'war-chest' ? 6 : 3)
            && data.completedAt is int && data.completedAt >= 0
            && data.keys().hasOnly(['uid','requestId','packId','dustSpent','cards','completedAt']))
          || (kind == 'rounds' && data.id == id && data.matchId is string && data.mode in ['campaign','bot','endless']
            && data.round is int && data.round >= 1 && data.round <= 7
            && data.cards is list && data.cards.size() <= 1
            && data.completedAt is int && data.completedAt >= 0
            && data.keys().hasOnly(['id','matchId','uid','mode','missionId','round','cards','completedAt']))
        );
      }
      allow get: if ownsSoloSave();
      allow create, update: if validSoloSave();
      allow list, delete: if false;
      match /{receiptCollection}/{id} {
        allow get: if ownsSoloSave() && receiptCollection in ['results','upgrades','purchases','rounds'];
        allow create: if validSoloReceipt(receiptCollection,id);
        allow list, update, delete: if false;
      }
      // Hub accounts sharing one Firebase identity retain distinct private saves.
      match /accounts/{accountKey} {
        allow get: if ownsSoloSave();
        allow create, update: if validSoloSave();
        allow list, delete: if false;
        match /{receiptCollection}/{id} {
          allow get: if ownsSoloSave() && receiptCollection in ['results','upgrades','purchases','rounds'];
          allow create: if validSoloReceipt(receiptCollection,id);
          allow list, update, delete: if false;
        }
      }
    }
    match /factionForgeAccounts/{uid} {
      allow get: if isAuthed() && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /factionForgeNames/{username} { allow read, write: if false; }
    match /factionForgeLobbySessions/{lobbyId} { allow read, write: if false; }
    match /factionForgeProfiles/{uid} {
      allow get: if isAuthed() && request.auth.uid == uid;
      allow list, write: if false;
      match /{subcollection}/{recordId} {
        allow read: if isAuthed() && request.auth.uid == uid && subcollection in ['history','upgrades','purchases'];
        allow write: if false;
      }
    }
    // Read matches through the authenticated API. Private seeds, frozen profiles,
    // receipts, and server replay state must never be client-mutable or public.
    match /factionForgeMatches/{matchId} {
      allow read, write: if false;
      match /{sub=**} { allow read, write: if false; }
    }
    function forgeProtectedProfileFields() {
      return ['crowncouncilElo','crowncouncilLastDelta','crowncouncilLastMatchAt',
        'factionForge','factionForgeUid','forgeDust','forgeTier','troopCards',
        'campaignProgress','ownerUid','authUid','turncraft','turncraftMMR','turncraftStats'];
    }
    function forgeBoundOwner(username) {
      return !exists(/databases/$(database)/documents/factionForgeNames/$(username))
        || get(/databases/$(database)/documents/factionForgeNames/$(username)).data.uid == request.auth.uid;
    }
    match /users/{userId} {
      allow read: if isAuthed();
      // Keep existing unrelated profile fields compatible; migrated usernames
      // become owner-only. TurnCraft personal progress is client-written;
      // competitive ratings stay protected by turncraftProfileUpdate().
      allow create: if isAuthed() && forgeBoundOwner(userId)
        && turncraftProfileCreate()
        && !request.resource.data.keys().hasAny(forgeProtectedProfileFields());
      allow update: if isAuthed() && forgeBoundOwner(userId)
        && turncraftProfileUpdate(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(forgeProtectedProfileFields());
      allow delete: if false;

      // Read the old per-device location only for that Firebase Auth identity.
      match /tiny_troops_profiles/{saveName} {
        allow get: if isAuthed() && request.auth.uid == userId;
      }
      // Game Hub usernames are the stable account identity. Anonymous Auth UIDs
      // may change between browsers; they are not the owner key for these saves.
      match /factionForge/{saveId} {
        function forgeProfilePath() { return /databases/$(database)/documents/users/$(userId)/factionForge/profile; }
        function validForgeAccountSave() {
          let d=request.resource.data;
          return isAuthed() && saveId == 'profile' && d.schemaVersion == 1
            && d.username == userId && d.uid is string && d.uid.size() >= 1 && d.uid.size() <= 128
            && d.forgeDust is int && d.forgeDust >= 0 && d.troops is map && d.troops.size() == 32
            && d.campaign is map && d.campaign.missions is map && d.campaign.missions.size() <= 30
            && d.campaign.endlessUnlocked is bool && d.campaign.endlessBest is int && d.campaign.endlessBest >= 0
            && d.wins is int && d.wins >= 0 && d.losses is int && d.losses >= 0
            && (d.rewardTarget == null || d.rewardTarget is string)
            && d.rewardDay is string && d.rewardCounts is map && d.updatedAt is int && d.updatedAt >= 0
            && forgeDeckFields(d)
            && d.keys().hasOnly(['schemaVersion','uid','username','forgeDust','troops','campaign','wins','losses','rewardTarget','rewardDay','rewardCounts','updatedAt','decks','selectedDeckId','selectedDeckIndex','deckImportAccountKey']);
        }
        function validForgeAccountReceipt(kind,id) {
          let d=request.resource.data;
          return isAuthed() && saveId == 'profile' && d.uid == getAfter(forgeProfilePath()).data.uid && (
            (kind == 'results' && d.id == id && d.mode in ['campaign','bot','endless'] && d.won is bool
              && d.completedAt is int && d.completedAt >= 0 && d.forgeDust is int && d.forgeDust >= 0
              && d.cards is list && d.unlocks is list && d.stars is int && d.stars >= 0 && d.stars <= 3
              && d.keys().hasOnly(['id','uid','mode','won','missionId','stars','cards','forgeDust','unlocks','completedAt']))
            || (kind == 'upgrades' && d.requestId == id && d.troopKey is string
              && d.fromTier is int && d.fromTier >= 1 && d.toTier == d.fromTier+1 && d.toTier <= 3
              && d.cardsSpent is int && d.cardsSpent >= 0 && d.dustSpent is int && d.dustSpent >= 0
              && d.completedAt is int && d.completedAt >= 0
              && d.keys().hasOnly(['uid','requestId','troopKey','fromTier','toTier','cardsSpent','dustSpent','completedAt']))
            || (kind == 'purchases' && d.requestId == id && d.packId in ['vanir','aesir','helions','war-chest','random-reinforcements']
              && d.dustSpent == (d.packId == 'war-chest' ? 90 : 50)
              && d.cards is list && d.cards.size() == (d.packId == 'war-chest' ? 6 : 3)
              && d.completedAt is int && d.completedAt >= 0
              && d.keys().hasOnly(['uid','requestId','packId','dustSpent','cards','completedAt']))
            || (kind == 'rounds' && d.id == id && d.matchId is string && d.mode in ['campaign','bot','endless']
              && d.round is int && d.round >= 1 && d.round <= 7 && d.cards is list && d.cards.size() <= 1
              && d.completedAt is int && d.completedAt >= 0
              && d.keys().hasOnly(['id','matchId','uid','mode','missionId','round','cards','completedAt']))
          );
        }
        allow get: if isAuthed() && saveId == 'profile';
        allow create, update: if validForgeAccountSave();
        allow list, delete: if false;
        match /{kind}/{id} {
          allow read: if isAuthed() && saveId == 'profile' && kind in ['results','upgrades','purchases','rounds'];
          allow create: if validForgeAccountReceipt(kind,id);
          allow update, delete: if false;
        }
      }
      match /turncraftHistory/{id} {
        allow read: if isAuthed();
        allow create: if turncraftReceipt(userId,id,request.resource.data)
          && getAfter(/databases/$(database)/documents/users/$(userId)).data.gameStats.turncraft.lastMatchId == id
          && turncraftStatsDelta(get(/databases/$(database)/documents/users/$(userId)).data.get('gameStats',{}).get('turncraft',{}),
            getAfter(/databases/$(database)/documents/users/$(userId)).data.gameStats.turncraft,request.resource.data);
        allow update, delete: if false;
      }
      match /turncraftPending/{id} {
        allow read: if isAuthed();
        allow create: if isAuthed() && request.resource.data.lobbyId == id && request.resource.data.username == userId
          && request.resource.data.createdAt is int && request.resource.data.createdAt >= 0
          && request.resource.data.keys().hasOnly(['lobbyId','username','createdAt'])
          && get(/databases/$(database)/documents/lobbies/$(id)).data.gameType == 'turncraft'
          && get(/databases/$(database)/documents/lobbies/$(id)).data.turncraftVersion == 1
          && get(/databases/$(database)/documents/lobbies/$(id)).data.status in ['waiting','started','finished']
          && turncraftParticipant(get(/databases/$(database)/documents/lobbies/$(id)).data,userId) != '';
        allow update: if false;
        allow delete: if isAuthed() && (existsAfter(/databases/$(database)/documents/users/$(userId)/turncraftHistory/$(id))
          || !exists(/databases/$(database)/documents/lobbies/$(id))
          || get(/databases/$(database)/documents/lobbies/$(id)).data.status == 'closed'
          || turncraftParticipant(get(/databases/$(database)/documents/lobbies/$(id)).data,userId) == '');
      }
      match /turncraftSoloHistory/{id} {
        allow read: if isAuthed();
        allow create: if isAuthed() && request.resource.data.username == userId && request.resource.data.id == id
          && request.resource.data.mode in ['campaign','survival'] && request.resource.data.outcome in ['win','loss']
          && request.resource.data.factionId in ['frontier','ascendant','brood']
          && request.resource.data.difficulty in ['easy','medium','hard','pro']
          && request.resource.data.stars is int && request.resource.data.stars >= 0 && request.resource.data.stars <= 3
          && request.resource.data.wave is int && request.resource.data.wave >= 0 && request.resource.data.wave <= 100000
          && request.resource.data.durationSeconds is int && request.resource.data.durationSeconds >= 0 && request.resource.data.durationSeconds <= 604800
          && request.resource.data.completedAt is int && request.resource.data.completedAt >= 0
          && request.resource.data.keys().hasOnly(['id','username','mode','outcome','missionId','arenaId','factionId','difficulty','stars','wave','durationSeconds','completedAt']);
        allow update, delete: if false;
      }
      match /turncraftSaves/{id} {
        allow get: if isAuthed() && id == 'active';
        allow create, update: if isAuthed() && id == 'active' && request.resource.data.username == userId
          && (request.resource.data.packed == null || request.resource.data.packed is string && request.resource.data.packed.size() <= 850000)
          && request.resource.data.savedAt is int && request.resource.data.savedAt >= 0
          && (request.resource.data.get('completedRunId',null) == null || request.resource.data.completedRunId is string && request.resource.data.completedRunId.size() <= 100)
          && request.resource.data.keys().hasOnly(['username','packed','savedAt','completedRunId']);
        allow list, delete: if false;
      }
      // A Bible result belongs to the signed-in username and is applied once.
      // Each player saves their own profile, so another game's account binding
      // cannot prevent the rest of the room from finishing a match.
      match /bibleGameResults/{id} {
        allow read: if isAuthed() && get(/databases/$(database)/documents/users/$(userId)).data.get('chatAuthUid','') == request.auth.uid;
        allow create: if isAuthed()
          && get(/databases/$(database)/documents/users/$(userId)).data.get('chatAuthUid','') == request.auth.uid
          && request.resource.data.keys().hasOnly(['sessionId','lobbyId','uid','appliedAt','outcome','change','oldElo','newElo'])
          && request.resource.data.sessionId == id && request.resource.data.lobbyId is string
          && request.resource.data.uid is string && request.resource.data.appliedAt == request.time
          && get(/databases/$(database)/documents/lobbies/$(request.resource.data.lobbyId)/bibleSessions/$(id)).data.status == 'ended'
          && get(/databases/$(database)/documents/lobbies/$(request.resource.data.lobbyId)/bibleSessions/$(id)).data.ratingsApplied == true
          && get(/databases/$(database)/documents/lobbies/$(request.resource.data.lobbyId)/bibleSessions/$(id)).data.ratingResults[request.resource.data.uid].uid == request.resource.data.uid
          && get(/databases/$(database)/documents/lobbies/$(request.resource.data.lobbyId)/bibleSessions/$(id)/players/$(request.resource.data.uid)).data.authUid == request.auth.uid
          && get(/databases/$(database)/documents/lobbies/$(request.resource.data.lobbyId)/bibleSessions/$(id)/players/$(request.resource.data.uid)).data.profileKey == userId;
        allow update, delete: if false;
      }
      // Preserve legacy username-scoped saves for the other hub games. The
      // explicitly validated game paths are excluded because allows combine by OR.
      match /{subcollection}/{document=**} {
        allow read, write: if isAuthed()
          && !(subcollection in ['factionForge','turncraftHistory','turncraftSoloHistory','turncraftSaves','turncraftPending','tiny_troops_profiles','bibleGameResults']);
      }
    }

    function validTinyTroopsSave(saveName) {
      let data = request.resource.data;
      return isAuthed() && saveName.matches('^[a-z0-9_-]{1,28}$')
        && data.cleanUsername == saveName
        && data.username is string && data.username.size() >= 1 && data.username.size() <= 100
        && data.password is string && data.password.size() >= 1 && data.password.size() <= 48
        && data.saveVersion == 'tiny_troops_v1'
        && data.updatedAtMs is int && data.updatedAtMs >= 0
        && data.sequence is int && data.sequence >= 0
        && data.reason is string && data.reason.size() <= 100
        && data.state is map && data.state.saveVersion == 'tiny_troops_v1'
        && data.state.round is int && data.state.round >= 1
        && data.state.squad is list && data.state.squad.size() in [16,20]
        && data.updatedAt == request.time
        && data.keys().hasOnly(['username','cleanUsername','password','saveVersion','updatedAtMs','sequence','reason','createOnly','state','updatedAt']);
    }

    match /tiny_troops_profiles/{saveName} {
      // Save-name/code lookup is supported; browsing every player's file is not.
      allow get: if isAuthed();
      allow create: if validTinyTroopsSave(saveName);
      allow update: if validTinyTroopsSave(saveName)
        && request.resource.data.password == resource.data.password
        && request.resource.data.updatedAtMs >= resource.data.updatedAtMs;

      match /runs/{runId} {
        allow read: if isAuthed();
        allow create: if isAuthed() && request.resource.data.runId == runId
          && request.resource.data.username is string
          && request.resource.data.round is int && request.resource.data.round >= 1
          && request.resource.data.kills is number && request.resource.data.kills >= 0
          && request.resource.data.points is number && request.resource.data.points >= 0
          && request.resource.data.coins is number && request.resource.data.coins >= 0
          && request.resource.data.dateTime is string
          && request.resource.data.keys().hasOnly(['username','round','kills','points','coins','dateTime','runId']);
      }
    }

    match /tiny_troops_meta/{documentId} {
      allow get: if isAuthed() && documentId == 'global_leaderboard';
      allow create, update: if isAuthed() && documentId == 'global_leaderboard'
        && request.resource.data.top10 is list && request.resource.data.top10.size() <= 10
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly(['top10','updatedAt']);
    }

    match /lobbies/{gameId} {
      allow read: if isAuthed();
      allow create: if isAuthed() && (turncraftType(request.resource.data) ? turncraftLobbyCreate() : ((forgeLobbyType(request.resource.data)) ? forgeLobbyCreate() : (request.resource.data.get('gameType','') != 'ironthrone' || (
        request.resource.data.hostUid == request.auth.uid && request.resource.data.members.keys().hasOnly([request.auth.uid])
        && request.resource.data.members[request.auth.uid] == request.resource.data.host && request.resource.data.status == 'waiting'))));
      allow update: if isAuthed() && ((turncraftType(resource.data) || turncraftType(request.resource.data)) ? turncraftLobbyUpdate() : ((forgeLobbyType(resource.data) || forgeLobbyType(request.resource.data)) ? forgeLobbyUpdate() : (resource.data.get('gameType','') != 'ironthrone' && request.resource.data.get('gameType','') != 'ironthrone' || (
        resource.data.get('gameType','') == 'ironthrone' && request.resource.data.get('gameType','') == 'ironthrone' && (
          (resource.data.status == 'waiting' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members','players','updatedAt'])
            && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid]) && request.resource.data.members.size() <= 6)
          || (resource.data.hostUid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']))
          || (ironController() && ironAfter().hostUid == request.auth.uid && request.resource.data.hostUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hostUid','host','updatedAt']))
        )))));
      allow delete: if isAuthed() && (!turncraftType(resource.data) || resource.data.get('turncraftVersion',0) != 1) && ((forgeLobbyType(resource.data)) ? forgeLobbyDelete() : (resource.data.get('gameType','') != 'ironthrone' || resource.data.hostUid == request.auth.uid && resource.data.status == 'waiting'));
      // Bible room metadata and the public scoreboard can be read while a
      // browser is joining. Private actions require a verified username and an
      // Auth-to-player index; team chats never inherit the legacy catch-all.
      function bibleLobby() { return get(/databases/$(database)/documents/lobbies/$(gameId)).data.get('gameType','') == 'biblegame'; }
      function bibleName(name) {
        return isAuthed() && bibleLobby() && name is string && name in get(/databases/$(database)/documents/lobbies/$(gameId)).data.players
          && get(/databases/$(database)/documents/users/$(name)).data.get('chatAuthUid','') == request.auth.uid;
      }
      function bibleSession(sid) { return get(/databases/$(database)/documents/lobbies/$(gameId)/bibleSessions/$(sid)).data; }
      function bibleMemberData(sid) { return get(/databases/$(database)/documents/lobbies/$(gameId)/bibleSessions/$(sid)/members/$(request.auth.uid)).data; }
      function bibleMember(sid) {
        return isAuthed() && bibleName(bibleMemberData(sid).profileKey)
          && get(/databases/$(database)/documents/lobbies/$(gameId)/bibleSessions/$(sid)/players/$(bibleMemberData(sid).playerUid)).data.authUid == request.auth.uid;
      }
      function bibleActive(sid) {
        return bibleMember(sid)
          && get(/databases/$(database)/documents/lobbies/$(gameId)/bibleSessions/$(sid)/players/$(bibleMemberData(sid).playerUid)).data.connectionId == bibleMemberData(sid).connectionId;
      }
      function bibleParticipant(sid) { return bibleActive(sid) && bibleMemberData(sid).playerUid in bibleSession(sid).participantUids; }
      function bibleWindow(sid) {
        let s=bibleSession(sid);
        return s.status == 'playing' && (s.mode == 'coop' || request.time < s.phaseStartedAt + duration.value(s.durationMs,'ms'));
      }
      function bibleConnection(sid,data) { return data.connectionId == bibleMemberData(sid).connectionId; }
