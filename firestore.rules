        let allowed0=locked.get('decks',{}).get('p0',null) == null ? [] : locked.decks.p0.troops;
        let allowed1=locked.get('decks',{}).get('p1',null) == null ? [] : locked.decks.p1.troops;
        let p0=forgeBattleSideAt(units,0)+forgeBattleSideAt(units,1)+forgeBattleSideAt(units,2)+forgeBattleSideAt(units,3)+forgeBattleSideAt(units,4)+forgeBattleSideAt(units,5)+forgeBattleSideAt(units,6)+forgeBattleSideAt(units,7)+forgeBattleSideAt(units,8)+forgeBattleSideAt(units,9);
        return units is list && units.size() <= 10 && p0 <= 5 && units.size()-p0 <= 5
          && forgeBattleUnitAt(units,allowed0,allowed1,0) && forgeBattleUnitAt(units,allowed0,allowed1,1) && forgeBattleUnitAt(units,allowed0,allowed1,2) && forgeBattleUnitAt(units,allowed0,allowed1,3) && forgeBattleUnitAt(units,allowed0,allowed1,4)
          && forgeBattleUnitAt(units,allowed0,allowed1,5) && forgeBattleUnitAt(units,allowed0,allowed1,6) && forgeBattleUnitAt(units,allowed0,allowed1,7) && forgeBattleUnitAt(units,allowed0,allowed1,8) && forgeBattleUnitAt(units,allowed0,allowed1,9);
      }
      // Each body inherits its side and troop type from these validated map
      // keys when decoded. This supports growing armies without enumerating
      // one rule expression per body in a flat snapshot array.
      function forgeBattleGroupCount(groups,troops) {
        let recruited=troops.size() == 0 ? 0 : groups.get(troops[0],[]).size()+groups.get(troops[1],[]).size()+groups.get(troops[2],[]).size()+groups.get(troops[3],[]).size()+groups.get(troops[4],[]).size();
        return recruited+('miragewarden' in troops ? 0 : groups.get('miragewarden',[]).size())+('hellspawn' in troops ? 0 : groups.get('hellspawn',[]).size())+('blood' in troops ? 0 : groups.get('blood',[]).size());
      }
      function forgeBattleGroupsForSide(groups,deck,roster) {
        let troops=deck == null ? [] : deck.troops;
        let allowed=troops.concat('phaser' in troops ? ['miragewarden'] : []).concat('matron' in troops ? ['hellspawn','blood'] : []);
        return groups is map && groups.keys().hasOnly(allowed)
          && (deck == null || (groups.get(troops[0],[]) is list && groups.get(troops[1],[]) is list && groups.get(troops[2],[]) is list && groups.get(troops[3],[]) is list && groups.get(troops[4],[]) is list))
          && groups.get('miragewarden',[]) is list && groups.get('hellspawn',[]) is list && groups.get('blood',[]) is list
          && forgeBattleGroupCount(groups,troops) <= forgeRosterCount(roster)+3;
      }
      function forgeStaticBattle(data) {
        let locked=getAfter(/databases/$(database)/documents/lobbies/$(gameId)/crowncouncil/state).data;
        let decks=locked.get('decks',{});
        let roster=locked.get('roster',{});
        return data.keys().hasAny(['unitGroups'])
          ? !data.keys().hasAny(['units']) && data.unitGroups is map && data.unitGroups.keys().hasOnly(['p0','p1'])
            && forgeBattleGroupsForSide(data.unitGroups.p0,decks.get('p0',null),roster.get('p0',[])) && forgeBattleGroupsForSide(data.unitGroups.p1,decks.get('p1',null),roster.get('p1',[]))
          : forgeLegacyStaticBattle(data);
      }
      match /crowncouncil/{docId} {
        allow read: if forgeStaticMember();
        allow create: if forgeStaticMember() && (docId == 'state' && forgeStaticHost() && forgeStaticState(request.resource.data) || docId == 'battle' && forgeStaticHost() && forgeStaticBattle(request.resource.data));
        allow update: if forgeStaticMember() && (docId == 'state' && forgeStaticState(request.resource.data) && forgeStaticDeckLock() || docId == 'battle' && forgeStaticHost() && forgeStaticBattle(request.resource.data));
        allow delete: if forgeStaticMember() && forgeStaticHost();
      }

      match /alliances/{allianceId} {
        allow read, write: if isAuthed() && !turncraftType(ironLobby());
      }

      match /highscores/{scoreId} {
        // Standalone One Hit Knight scores do not require a multiplayer lobby document.
        function validKnightScore() {
          let d = request.resource.data;
          return isAuthed()
            && d.keys().hasAll(['name','score','wave','kills','mode','uid','createdMs','createdAt'])
            && d.keys().hasOnly(['name','score','wave','kills','mode','uid','createdMs','createdAt'])
            && d.uid == request.auth.uid
            && d.name is string && d.name.matches('^[A-Z0-9 _.-]{1,16}$')
            && d.score is int && d.score > 0 && d.score <= 1000000000000
            && d.wave is int && d.wave >= 1 && d.wave <= 1000000
            && d.kills is int && d.kills >= 0 && d.kills <= 1000000000
            && d.mode in ['CLASSIC','CHAOS','60 SECOND']
            && d.createdMs is int && d.createdMs >= request.time.toMillis() - 300000
            && d.createdMs <= request.time.toMillis() + 300000
            && d.createdAt == request.time;
        }
        allow read: if isAuthed() && gameId in ['world_quest','one_hit_knight'];
        allow create: if gameId == 'world_quest' && validCountryQuestScore()
          || gameId == 'one_hit_knight' && validKnightScore();
        allow update: if gameId == 'world_quest'
          && validCountryQuestScore()
          && resource.data.uid == request.auth.uid
          && request.resource.data.score >= resource.data.score;
        allow delete: if gameId == 'world_quest'
          && isAuthed()
          && resource.data.uid == request.auth.uid;
      }

      // Grass Realms and War Realms keep their synchronized match snapshot on
      // this lobby document and authenticated readiness/deck data in presence/{uid}.
      // Academy and other lobby-backed games also use authenticated subcollections.
      match /{subcollection}/{document=**} {
        allow read, write: if isAuthed() && gameId != 'world_quest'
          && !(gameId == 'one_hit_knight' && subcollection == 'highscores')
          && (!turncraftType(ironLobby()) || ironLobby().get('turncraftVersion',0) != 1)
          && subcollection != 'rpg_rooms'
          && !(gameId == 'turncraft' && subcollection == 'invites')
          && !(subcollection in ['crowncouncil','iron_throne','iron_throne_private','iron_throne_presence','iron_throne_commands','iron_throne_snapshots','iron_throne_threads','bibleGame','bibleSessions']);
      }
    }

    // A controller can queue a completed result for disconnected participants.
    // Only the recipient can read/remove it; the referenced session is immutable
    // after finalization and the username receipt prevents a second application.
    match /bibleGameRatingInbox/{authUid}/matches/{sid} {
      function bibleInboxSession() { return getAfter(/databases/$(database)/documents/lobbies/$(request.resource.data.lobbyId)/bibleSessions/$(sid)).data; }
      function bibleInboxSender() { return get(/databases/$(database)/documents/lobbies/$(request.resource.data.lobbyId)/bibleSessions/$(sid)/members/$(request.auth.uid)).data; }
      allow read, delete: if isAuthed() && authUid == request.auth.uid;
      allow create: if isAuthed() && request.resource.data.keys().hasOnly(['lobbyId','sessionId','uid','profileKey'])
        && request.resource.data.sessionId == sid && request.resource.data.lobbyId is string
        && bibleInboxSession().status == 'ended' && bibleInboxSession().ratingsApplied == true
        && bibleInboxSender().playerUid in bibleInboxSession().participantUids
        && get(/databases/$(database)/documents/users/$(bibleInboxSender().profileKey)).data.chatAuthUid == request.auth.uid
        && bibleInboxSession().ratingResults[request.resource.data.uid].authUid == authUid
        && bibleInboxSession().ratingResults[request.resource.data.uid].profileKey == request.resource.data.profileKey
        && request.resource.data.uid in bibleInboxSession().participantUids
        && bibleInboxSession().ratingResults[request.resource.data.uid].uid == request.resource.data.uid;
      allow update: if false;
    }

    match /rewards/{rewardId} {
      // The game queries this collection with where('uid', '==', auth.uid).
      allow read: if isAuthed()
        && resource.data.uid == request.auth.uid;

      // The elected room controller creates rewards. Firestore rules cannot
      // independently verify an RTDB controller lease; a trusted backend is
      // required for fully cheat-resistant reward issuance.
      allow create: if isAuthed()
        && validRewardCreate(rewardId)
        && validRewardNumbersAndPayload()
        && validRewardOptionalPayload();

      // A recipient may only mark their own reward claimed.
      allow update: if isAuthed()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.id == resource.data.id
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'claimed',
          'claimedAt'
        ])
        && request.resource.data.claimed == true
        && request.resource.data.claimedAt is timestamp
        && request.resource.data.claimedAt == request.time;

      // The game deletes the document after the successful profile transaction.
      allow delete: if isAuthed()
        && resource.data.uid == request.auth.uid
        && resource.data.claimed == true;
    }


    // Keep the existing hub's username-based invitations for other games.
    match /lobbyInvites/{inviteId} {
      allow read, create, update, delete: if isAuthed();
    }

    match /gameStats/{gameId} {
      allow read, write: if isAuthed();
    }

    // Community chat is split so Firestore can enforce private visibility.
    // Public messages are readable by signed-in visitors and become deletable
    // after the same 24-hour retention window used by the client.
    match /chat/{messageId} {
      allow read: if isAuthed();
      allow create: if isAuthed()
        && request.resource.data.username is string
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 500
        && request.resource.data.type in ['message', 'lobby_ad'];
      allow update: if false;
      allow delete: if isAuthed()
        && resource.data.timestamp < request.time - duration.value(24, 'h');
    }

    // Each private document carries the two Firebase Auth UIDs. Queries must
    // use array-contains(request.auth.uid), allowing rules to prove that every
    // returned message belongs to the current participant.
    match /privateChat/{messageId} {
      allow read: if isAuthed()
        && request.auth.uid in resource.data.participantUids;
      allow create: if isAuthed()
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.recipientUid is string
        && request.resource.data.participantUids is list
        && request.resource.data.participantUids.size() == 2
        && request.auth.uid in request.resource.data.participantUids
        && request.resource.data.username is string
        && request.resource.data.privateTo is string
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 500
        && request.resource.data.type == 'private';
      allow update: if false;
      allow delete: if isAuthed()
        && request.auth.uid in resource.data.participantUids
        && resource.data.timestamp < request.time - duration.value(24, 'h');
    }

    match /metrics_dailyUsers/{dateKey} {
      match /users/{uid} {
        allow read, write: if isAuthed();
      }
    }

    match /grid_overlord_games/{gameId} {
      allow read, write: if isAuthed();

      match /players/{playerId} {
        allow read: if isAuthed();
        allow write: if isAuthed() && request.auth.uid == playerId;
      }

      match /nodes/{nodeId} {
        allow read, write: if isAuthed();
      }
    }

    match /castlepanic_games/{gameId} {
      allow read, write: if isAuthed();

      match /players/{playerId} {
        allow read: if isAuthed();
        allow write: if isAuthed() && request.auth.uid == playerId;
      }

      match /nodes/{nodeId} {
        allow read, write: if isAuthed();
      }
    }

    match /micromon_saves/{saveId} {
      allow read, write: if isAuthed();
    }

    match /mqUsers/{username} {
      allow read, write: if isAuthed();
    }

    match /games_rogueduel/{gameId} {
      allow read: if isAuthed();
      // Freeze only Mountain Blade's old display-name saves for verified migration.
      // Both rules exclude the game: a recursive allow cannot be narrowed below.
      allow write: if isAuthed() && gameId != 'mountandblade_online';
      match /{collection}/{sub=**} {
        allow read: if isAuthed();
        allow write: if isAuthed() && gameId != 'mountandblade_online'
          && !(gameId == 'monkey_trails_v1' && collection in ['sale_operations','saves']);
      }
      match /saves/{id} {
        // Keep encrypted saves compatible while retaining every permanent-sale
        // receipt across stale-device checkpoints and older clients.
        allow create, update: if isAuthed() && gameId == 'monkey_trails_v1'
          && request.resource.data.get('saleIds',[]) is list
          && (resource == null || request.resource.data.get('saleIds',[]).toSet().hasAll(resource.data.get('saleIds',[])));
        allow delete: if isAuthed() && gameId == 'monkey_trails_v1' && resource.data.get('saleIds',[]).size() == 0;
      }
      match /sale_operations/{id} {
        allow get: if isAuthed() && gameId == 'monkey_trails_v1';
        allow create: if isAuthed() && gameId == 'monkey_trails_v1' && id.matches('^[0-9a-f]{64}$')
          && request.resource.data.keys().hasOnly(['saveId','fingerprint','createdAt'])
          && request.resource.data.saveId is string && request.resource.data.saveId.matches('^[0-9a-f]{64}$')
          && request.resource.data.fingerprint is string && request.resource.data.fingerprint.matches('^[0-9a-f]{64}$')
          && request.resource.data.createdAt == request.time
          && id in getAfter(/databases/$(database)/documents/games_rogueduel/monkey_trails_v1/saves/$(request.resource.data.saveId)).data.saleIds;
        allow update, delete: if false;
      }
    }

    // Monkey Trails social play is isolated from permissive legacy save rules.
    // Browser simulation is deterministic and checked by both participants;
    // these rules protect ownership, transactions, membership and replay bounds.
    match /monkeyTrailsSocial/{version} {
      function mtEnabled() { return version == 'v1' && isAuthed(); }
      function mtFresh(value) { return value is int && value >= request.time.toMillis()-120000 && value <= request.time.toMillis()+120000; }
      function mtPlayer(uid) { return get(/databases/$(database)/documents/monkeyTrailsSocial/v1/players/$(uid)).data; }
      function mtPlayerAfter(uid) { return getAfter(/databases/$(database)/documents/monkeyTrailsSocial/v1/players/$(uid)).data; }
      function mtTribe(id) { return get(/databases/$(database)/documents/monkeyTrailsSocial/v1/tribes/$(id)).data; }
      function mtTribeAfter(id) { return getAfter(/databases/$(database)/documents/monkeyTrailsSocial/v1/tribes/$(id)).data; }
      function mtOp(id) { return getAfter(/databases/$(database)/documents/monkeyTrailsSocial/v1/operations/$(id)).data; }
      function mtAsset(id) { return id in ['fruit','berry','tonic','salve','revive','bondCharm','trailRibbon','treasureScent','scoutFeather','campfireSeed','charmMaterial']; }
      function mtQuantity(n) { return n is int && n > 0 && n <= 100000; }
      function mtWallet(w) { return w is map && w.keys().hasOnly(['fruit','items']) && w.fruit is int && w.fruit >= 0 && w.fruit <= 1000000000 && w.items is map && w.items.size() <= 16 && w.items.keys().hasOnly(['berry','tonic','salve','revive','bondCharm','trailRibbon','treasureScent','scoutFeather','campfireSeed','charmMaterial']); }
      function mtPair(a) { return a is map && a.keys().hasOnly(['asset','amount']) && mtAsset(a.asset) && mtQuantity(a.amount); }
      function mtMove(before,after,asset,amount) {
        return mtAsset(asset)
          && (asset == 'fruit' ? after.items == before.items && after.fruit == before.fruit+amount
            : after.fruit == before.fruit && after.items.diff(before.items).affectedKeys().hasOnly([asset])
              && after.items.get(asset,0) == before.items.get(asset,0)+amount && after.items.get(asset,0) >= 0);
      }
      function mtSwap(before,after,give,want) {
        return mtPair(give) && mtPair(want)
          && after.fruit == before.fruit-(give.asset == 'fruit' ? give.amount : 0)+(want.asset == 'fruit' ? want.amount : 0)
          && after.items.diff(before.items).affectedKeys().hasOnly([give.asset,want.asset])
          && (give.asset == 'fruit' || after.items.get(give.asset,0) == before.items.get(give.asset,0)-give.amount+(want.asset == give.asset ? want.amount : 0))
          && (want.asset == 'fruit' || after.items.get(want.asset,0) == before.items.get(want.asset,0)+want.amount-(give.asset == want.asset ? give.amount : 0))
          && (give.asset == 'fruit' || after.items.get(give.asset,0) >= 0) && (want.asset == 'fruit' || after.items.get(want.asset,0) >= 0);
      }
      function mtSameTribe(a,b) { return mtPlayer(a).tribeId is string && mtPlayer(a).tribeId == mtPlayer(b).tribeId && a in mtTribe(mtPlayer(a).tribeId).members && b in mtTribe(mtPlayer(a).tribeId).members; }
      function mtChange(op,uid,before,after) {
        let d=op.details;
        return uid in op.participants && d.wallets[uid].before == before && d.wallets[uid].after == after
          && ((op.kind == 'deposit' && op.actor == uid && d.uid == uid && mtMove(before,after,d.asset,d.amount))
            || (op.kind == 'withdraw' && op.actor == uid && d.uid == uid && mtMove(before,after,d.asset,-d.amount))
            || (op.kind == 'gift' && mtMove(before,after,d.asset,uid == d.from ? -d.amount : d.amount))
            || (op.kind == 'trade-offer' && uid == op.actor && mtMove(before,after,d.give.asset,-d.give.amount))
            || (op.kind == 'trade-cancel' && uid == d.from && mtMove(before,after,d.give.asset,d.give.amount))
            || (op.kind == 'trade' && uid in [d.from,d.to] && (uid == d.from ? mtMove(before,after,d.want.asset,d.want.amount) : mtSwap(before,after,d.want,d.give)))
            || (op.kind == 'duel-start' && mtMove(before,after,'fruit',-d.escrow[uid]))
            || (op.kind == 'duel' && mtMove(before,after,'fruit',d.winner == null ? d.escrow[uid] : d.winner == uid ? d.escrow[op.participants[0]]+d.escrow[op.participants[1]] : 0))
            || (op.kind == 'raid' && after.fruit == before.fruit+d.reward.fruit && after.items.diff(before.items).affectedKeys().hasOnly(['berry','bondCharm']) && after.items.get('berry',0) == before.items.get('berry',0)+1 && after.items.get('bondCharm',0) == before.items.get('bondCharm',0)+(d.level%3 == 0 ? 1 : 0)));
      }
      function mtPlayerShape(d,uid) {
        return d.keys().hasOnly(['uid','saveId','name','team','averageLevel','tribeId','wallet','activeDuel','activeRaid','lastRaidAt','version','lastOp','createdAt','updatedAt'])
          && d.uid == uid && d.saveId is string && d.saveId.size() >= 1 && d.saveId.size() <= 100
          && d.name is string && d.name.size() >= 1 && d.name.size() <= 30 && d.team is list && d.team.size() >= 1 && d.team.size() <= 3
          && d.averageLevel is int && d.averageLevel >= 1 && d.averageLevel <= 60 && mtWallet(d.wallet)
          && (d.tribeId == null || d.tribeId is string) && (d.activeDuel == null || d.activeDuel is string) && (d.activeRaid == null || d.activeRaid is string)
          && d.lastRaidAt is int && d.lastRaidAt >= 0 && d.version is int && d.version >= 0 && d.lastOp is string && mtFresh(d.updatedAt);
      }
      function mtApproval(uid,tribeId) {
        let t=mtTribeAfter(tribeId);
        let path=/databases/$(database)/documents/monkeyTrailsSocial/v1/applications/$(t.get('lastApplication',''));
        let before=get(path).data;
        let after=getAfter(path).data;
        return t.ownerId == request.auth.uid && before.uid == uid && before.tribeId == tribeId
          && before.status == 'pending' && before.expiresAt > request.time.toMillis()
          && after.status == 'accepted' && after.decidedBy == request.auth.uid && mtApplicantAvailable(uid);
      }
      function mtMembershipFree(uid) { let p=mtPlayer(uid); return p.activeDuel == null && p.activeRaid == null; }
      function mtApplicantAvailable(uid) { let path=/databases/$(database)/documents/monkeyTrailsSocial/v1/presence/$(uid); return !exists(path) || get(path).data.online == false || get(path).data.busy == false || get(path).data.expiresAt <= request.time.toMillis(); }
      function mtNoTrades(uid) { let path=/databases/$(database)/documents/monkeyTrailsSocial/v1/tradeLocks/$(uid); return !exists(path) || get(path).data.offers.size() == 0; }
      match /players/{uid} {
        allow read: if mtEnabled();
        allow create: if mtEnabled() && request.auth.uid == uid && mtPlayerShape(request.resource.data,uid)
          && request.resource.data.version == 0 && request.resource.data.tribeId == null && request.resource.data.activeDuel == null && request.resource.data.activeRaid == null
          && request.resource.data.wallet == {'fruit':0,'items':{}} && request.resource.data.lastRaidAt == 0 && mtFresh(request.resource.data.createdAt);
        allow update: if mtEnabled() && mtPlayerShape(request.resource.data,uid)
          && request.resource.data.uid == resource.data.uid && request.resource.data.saveId == resource.data.saveId && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.version == resource.data.version+1
          && (request.resource.data.tribeId == resource.data.tribeId || mtMembershipFree(uid) && (request.auth.uid == uid && (request.resource.data.tribeId == null ? !(uid in mtTribeAfter(resource.data.tribeId).members) : resource.data.tribeId == null && uid in mtTribeAfter(request.resource.data.tribeId).members) || resource.data.tribeId == null && request.resource.data.tribeId is string && mtApproval(uid,request.resource.data.tribeId)))
          && (request.auth.uid == uid || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tribeId','version','updatedAt']) && request.resource.data.tribeId is string && mtApproval(uid,request.resource.data.tribeId) || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['wallet','activeDuel','version','lastOp','updatedAt']))
          && (request.resource.data.lastRaidAt == resource.data.lastRaidAt || request.auth.uid == uid && resource.data.activeRaid == null && resource.data.lastRaidAt <= request.time.toMillis()-3600000 && request.resource.data.activeRaid is string && mtFresh(request.resource.data.lastRaidAt)
            && getAfter(/databases/$(database)/documents/monkeyTrailsSocial/v1/raids/$(request.resource.data.activeRaid)).data.uid == uid)
          && (request.resource.data.activeRaid == resource.data.activeRaid || request.auth.uid == uid && (request.resource.data.activeRaid == null || resource.data.activeRaid == null && request.resource.data.lastRaidAt != resource.data.lastRaidAt))
          && (request.resource.data.activeDuel == resource.data.activeDuel || (request.resource.data.activeDuel == null ? request.auth.uid == uid && get(/databases/$(database)/documents/monkeyTrailsSocial/v1/duels/$(resource.data.activeDuel)).data.settled == true
            : resource.data.activeDuel == null && mtOp(request.resource.data.lastOp).kind == 'duel-start' && mtOp(request.resource.data.lastOp).details.duelId == request.resource.data.activeDuel && uid in getAfter(/databases/$(database)/documents/monkeyTrailsSocial/v1/duels/$(request.resource.data.activeDuel)).data.players))
          && (request.resource.data.wallet == resource.data.wallet && (request.auth.uid == uid || request.resource.data.tribeId is string && resource.data.tribeId == null && mtApproval(uid,request.resource.data.tribeId))
            || !exists(/databases/$(database)/documents/monkeyTrailsSocial/v1/operations/$(request.resource.data.lastOp)) && mtOp(request.resource.data.lastOp).actor == request.auth.uid && mtFresh(mtOp(request.resource.data.lastOp).createdAt)
              && mtChange(mtOp(request.resource.data.lastOp),uid,resource.data.wallet,request.resource.data.wallet));
        allow delete: if false;
      }
      match /presence/{uid} {
        allow read: if mtEnabled();
        allow create, update: if mtEnabled() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['uid','name','tribeId','online','busy','discoverable','location','seenAt','expiresAt'])
          && request.resource.data.uid == uid && request.resource.data.name is string && request.resource.data.name.size() <= 30
          && request.resource.data.online is bool && request.resource.data.busy is bool && request.resource.data.discoverable is bool
          && request.resource.data.tribeId == mtPlayer(uid).tribeId && mtFresh(request.resource.data.seenAt)
          && request.resource.data.expiresAt is int && request.resource.data.expiresAt >= request.resource.data.seenAt && request.resource.data.expiresAt <= request.resource.data.seenAt+90000
          && (request.resource.data.location == null || request.resource.data.discoverable == true && request.resource.data.location.keys().hasOnly(['lat','lon','accuracy','at'])
            && request.resource.data.location.lat is number && request.resource.data.location.lat >= -90 && request.resource.data.location.lat <= 90
            && request.resource.data.location.lon is number && request.resource.data.location.lon >= -180 && request.resource.data.location.lon <= 180
            && request.resource.data.location.accuracy is number && request.resource.data.location.accuracy >= 0 && request.resource.data.location.accuracy <= 500 && mtFresh(request.resource.data.location.at));
