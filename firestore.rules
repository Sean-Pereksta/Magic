          && (request.resource.data.actions.size() == resource.data.actions.size() || request.resource.data.actions[request.resource.data.actions.size()-1].action.type != 'surrender'
            || request.resource.data.status == 'finished' && request.resource.data.state.winner == (request.resource.data.actions[request.resource.data.actions.size()-1].uid == resource.data.players[0] ? resource.data.players[1] : resource.data.players[0]))
          && (request.resource.data.status == 'active' ? request.resource.data.state.status == 'active' && request.resource.data.state.winner == null && request.resource.data.state.turn == 1-resource.data.state.turn : request.resource.data.status == 'finished' && request.resource.data.state.status == 'finished')
          && (resource.data.status == 'active' && request.resource.data.revision == resource.data.revision+1 && request.resource.data.actions.size() == resource.data.actions.size()+1 && request.resource.data.actions == resource.data.actions.concat([request.resource.data.actions[request.resource.data.actions.size()-1]])
              && (request.resource.data.actions[request.resource.data.actions.size()-1].uid == request.auth.uid
                && (resource.data.players[resource.data.state.turn] == request.auth.uid || request.resource.data.actions[request.resource.data.actions.size()-1].action.type == 'surrender')
                || request.resource.data.actions[request.resource.data.actions.size()-1].get('timeout',false) == true
                  && request.resource.data.actions[request.resource.data.actions.size()-1].claimedBy == request.auth.uid
                  && request.resource.data.actions[request.resource.data.actions.size()-1].uid == resource.data.players[resource.data.state.turn]
                  && request.resource.data.actions[request.resource.data.actions.size()-1].uid != request.auth.uid
                  && resource.data.updatedAt <= request.time.toMillis()-90000)
            || resource.data.settled == false && request.resource.data.settled == true && request.resource.data.status == 'finished' && request.resource.data.revision == resource.data.revision && request.resource.data.actions == resource.data.actions && request.resource.data.state == resource.data.state);
        allow delete: if false;
      }
      // Weekly objectives accept client-reported counts, never coordinates. Stable
      // week+uid records serialize retries and prevent hopping tribes for rewards.
      function mtWeekStart() { return int(math.floor((request.time.toMillis()-345600000) / 604800000))*604800000+345600000; }
      function mtAdventureMember(week,uid) { return get(/databases/$(database)/documents/monkeyTrailsSocial/v1/adventureMembers/$(string(week)+'-'+uid)).data; }
      function mtAdventureMemberAfter(week,uid) { return getAfter(/databases/$(database)/documents/monkeyTrailsSocial/v1/adventureMembers/$(string(week)+'-'+uid)).data; }
      function mtAdventureCounts(c) { return c is map && c.keys().hasAll(['meters','discoveries','challenges','raids','trades']) && c.keys().hasOnly(['meters','discoveries','challenges','raids','trades']) && c.meters is int && c.meters >= 0 && c.meters <= 1000000000 && c.discoveries is int && c.discoveries >= 0 && c.discoveries <= 1000000000 && c.challenges is int && c.challenges >= 0 && c.challenges <= 1000000000 && c.raids is int && c.raids >= 0 && c.raids <= 1000000000 && c.trades is int && c.trades >= 0 && c.trades <= 1000000000; }
      function mtAdventurePoints(c) { return int(math.floor(c.meters / 50))+c.discoveries*3+c.challenges*25+c.raids*25+c.trades*15; }
      function mtAdventureDifference(d) { return d.contribution.meters == d.counters.meters-d.baseline.meters && d.contribution.discoveries == d.counters.discoveries-d.baseline.discoveries && d.contribution.challenges == d.counters.challenges-d.baseline.challenges && d.contribution.raids == d.counters.raids-d.baseline.raids && d.contribution.trades == d.counters.trades-d.baseline.trades; }
      function mtAdventureShape(d,id) { return d.keys().hasOnly(['id','tribeId','weekStart','weekEnd','target','points','updatedAt']) && d.id == id && d.weekStart in [mtWeekStart(),mtWeekStart()-604800000] && d.weekEnd == d.weekStart+604800000 && d.target == 600 && d.points is int && d.points >= 0 && d.points <= 1000000000 && mtFresh(d.updatedAt) && mtPlayer(request.auth.uid).tribeId == d.tribeId && request.auth.uid in mtTribe(d.tribeId).members && id == string(d.weekStart)+'-'+d.tribeId; }
      function mtAdventureMemberShape(d,id) { return d.keys().hasOnly(['id','uid','saveId','tribeId','summaryId','weekStart','weekEnd','baseline','counters','contribution','points','joinedAt','updatedAt']) && d.id == id && id == string(d.weekStart)+'-'+request.auth.uid && d.uid == request.auth.uid && d.saveId == mtPlayer(request.auth.uid).saveId && d.tribeId == mtPlayer(request.auth.uid).tribeId && request.auth.uid in mtTribe(d.tribeId).members && d.weekStart in [mtWeekStart(),mtWeekStart()-604800000] && d.weekEnd == d.weekStart+604800000 && d.summaryId == string(d.weekStart)+'-'+d.tribeId && mtAdventureCounts(d.baseline) && mtAdventureCounts(d.counters) && mtAdventureCounts(d.contribution) && mtAdventureDifference(d) && d.points == mtAdventurePoints(d.contribution) && mtFresh(d.updatedAt); }
      function mtAdventureSummaryAfter(d) { return getAfter(/databases/$(database)/documents/monkeyTrailsSocial/v1/adventures/$(d.summaryId)).data; }
      match /adventures/{id} {
        allow get: if mtEnabled() && (resource == null || request.auth.uid in mtTribe(resource.data.tribeId).members);
        allow list: if mtEnabled() && request.auth.uid in mtTribe(resource.data.tribeId).members;
        allow create: if mtEnabled() && mtAdventureShape(request.resource.data,id) && request.resource.data.weekStart == mtWeekStart() && request.resource.data.points == 0;
        allow update: if mtEnabled() && mtAdventureShape(request.resource.data,id) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['points','updatedAt']) && request.resource.data.points == resource.data.points+mtAdventureMemberAfter(resource.data.weekStart,request.auth.uid).points-mtAdventureMember(resource.data.weekStart,request.auth.uid).points;
        allow delete: if false;
      }
      match /adventureMembers/{id} {
        allow get: if mtEnabled() && (resource == null || resource.data.uid == request.auth.uid || request.auth.uid in mtTribe(resource.data.tribeId).members);
        allow list: if mtEnabled() && (resource.data.uid == request.auth.uid || request.auth.uid in mtTribe(resource.data.tribeId).members);
        allow create: if mtEnabled() && mtAdventureMemberShape(request.resource.data,id) && request.resource.data.weekStart == mtWeekStart() && request.resource.data.baseline == request.resource.data.counters && request.resource.data.points == 0 && mtFresh(request.resource.data.joinedAt) && mtAdventureSummaryAfter(request.resource.data).tribeId == request.resource.data.tribeId;
        allow update: if mtEnabled() && mtAdventureMemberShape(request.resource.data,id) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['counters','contribution','points','updatedAt']) && request.resource.data.counters.meters >= resource.data.counters.meters && request.resource.data.counters.discoveries >= resource.data.counters.discoveries && request.resource.data.counters.challenges >= resource.data.counters.challenges && request.resource.data.counters.raids >= resource.data.counters.raids && request.resource.data.counters.trades >= resource.data.counters.trades && mtAdventureSummaryAfter(request.resource.data).points == get(/databases/$(database)/documents/monkeyTrailsSocial/v1/adventures/$(resource.data.summaryId)).data.points+request.resource.data.points-resource.data.points;
        allow delete: if false;
      }
      function mtAdventureCosmetic(week) { let style=int(math.floor(week / 604800000))%4; return style == 0 ? 'canopy-banner' : style == 1 ? 'sunstone-emblem' : style == 2 ? 'moonwell-sanctuary' : 'crystal-banner'; }
      function mtAdventureClaim(d,id) {
        let member=mtAdventureMember(d.weekStart,request.auth.uid);
        let summary=get(/databases/$(database)/documents/monkeyTrailsSocial/v1/adventures/$(member.summaryId)).data;
        return d.keys().hasOnly(['id','uid','saveId','tribeId','summaryId','weekStart','contribution','reward','claimedAt']) && d.id == id && id == string(d.weekStart)+'-'+request.auth.uid && d.uid == request.auth.uid && d.saveId == mtPlayer(request.auth.uid).saveId && d.saveId == member.saveId && d.tribeId == member.tribeId && d.tribeId == mtPlayer(request.auth.uid).tribeId && request.auth.uid in mtTribe(d.tribeId).members && d.summaryId == member.summaryId && d.contribution == member.contribution && member.points > 0 && summary.points >= 600 && d.weekStart in [mtWeekStart(),mtWeekStart()-604800000] && mtFresh(d.claimedAt) && d.reward == {'fruit':6,'items':{'berry':1},'cosmetic':mtAdventureCosmetic(d.weekStart)};
      }
      match /adventureClaims/{id} {
        allow get: if mtEnabled() && (resource == null || resource.data.uid == request.auth.uid);
        allow list: if mtEnabled() && resource.data.uid == request.auth.uid;
        allow create: if mtEnabled() && mtAdventureClaim(request.resource.data,id);
        allow update, delete: if false;
      }
      function mtAssetPayload(p,asset,amount) {
        return p.keys().hasOnly(['fruit','xp','items']) && p.xp == 0
          && (asset == 'fruit' ? p.fruit == amount && p.items == {} : p.fruit == 0 && p.items.keys().hasOnly([asset]) && p.items.get(asset,0) == amount);
      }
      function mtTeamIds(members) { return members.size() == 1 ? [members[0].id] : members.size() == 2 ? [members[0].id,members[1].id] : [members[0].id,members[1].id,members[2].id]; }
      function mtDuelReceipt(op,uid,p) {
        let d=getAfter(/databases/$(database)/documents/monkeyTrailsSocial/v1/duels/$(op.details.duelId)).data;
        let other=d.players[0] == uid ? d.players[1] : d.players[0];
        let base=12+mtPlayer(uid).averageLevel*2;
        let xp=(base > 120 ? 120 : base)+(d.state.winner == uid ? 8 : 0);
        let payout=d.state.winner == null ? d.escrow[uid] : d.state.winner == uid ? d.escrow[d.players[0]]+d.escrow[d.players[1]] : 0;
        return p.keys().hasOnly(['fruit','xp','items','teamIds','payoutFruit']) && p.xp == xp && p.items == {}
          && p.fruit == (d.state.winner == uid ? d.escrow[other] : 0) && p.payoutFruit == payout && p.teamIds == mtTeamIds(mtPlayer(uid).team);
      }
      function mtReceiptPayload(op,uid,p,credited) {
        return (op.kind == 'withdraw' && uid == op.actor && credited == false && mtAssetPayload(p,op.details.asset,op.details.amount))
          || (op.kind == 'gift' && uid == op.details.to && credited == true && mtAssetPayload(p,op.details.asset,op.details.amount))
          || (op.kind == 'trade' && credited == true && (uid == op.details.from ? mtAssetPayload(p,op.details.want.asset,op.details.want.amount) : mtAssetPayload(p,op.details.give.asset,op.details.give.amount)))
          || (op.kind == 'raid' && credited == true && p.keys().hasOnly(['fruit','xp','items','teamIds']) && p.fruit == op.details.reward.fruit && p.xp == op.details.reward.xp
            && p.items == (op.details.level%3 == 0 ? {'berry':1,'bondCharm':1} : {'berry':1}) && p.teamIds == mtTeamIds(mtPlayer(uid).team))
          || (op.kind == 'duel' && credited == true && mtDuelReceipt(op,uid,p));
      }
      match /receipts/{uid}/entries/{id} {
        allow read: if mtEnabled() && request.auth.uid == uid;
        allow create: if mtEnabled() && request.resource.data.id == id && id == request.resource.data.sourceId && request.resource.data.uid == uid && request.resource.data.seen == false
          && mtFresh(request.resource.data.createdAt) && mtOp(request.resource.data.sourceId).actor == request.auth.uid && uid in mtOp(request.resource.data.sourceId).participants
          && mtPlayerAfter(uid).lastOp == request.resource.data.sourceId && mtOp(request.resource.data.sourceId).details.wallets[uid].after == mtPlayerAfter(uid).wallet
          && mtReceiptPayload(mtOp(request.resource.data.sourceId),uid,request.resource.data.payload,request.resource.data.walletCredited)
          && request.resource.data.type == mtOp(request.resource.data.sourceId).details.receipts[uid].type
          && request.resource.data.title == mtOp(request.resource.data.sourceId).details.receipts[uid].title
          && request.resource.data.payload == mtOp(request.resource.data.sourceId).details.receipts[uid].payload
          && request.resource.data.walletCredited == mtOp(request.resource.data.sourceId).details.receipts[uid].walletCredited
          && request.resource.data.payload is map && request.resource.data.payload.fruit is int && request.resource.data.payload.fruit >= 0 && request.resource.data.payload.fruit <= 1000000 && request.resource.data.payload.xp is int && request.resource.data.payload.xp >= 0 && request.resource.data.payload.xp <= 10000 && request.resource.data.payload.items is map;
        allow update: if mtEnabled() && request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen','seenAt']) && request.resource.data.seen == true;
        allow delete: if false;
      }
    }

    match /games_basewar/{gameId} {
      allow read, write: if isAuthed();

      match /commands/{cmdId} {
        allow read, write: if isAuthed();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
